---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import interFont from '@weekndlabs/design/fonts/inter-100-900.woff2?url';
import '../styles/global.css';

interface Props {
	title: string;
    description: string;
    image?: string;
    imageAlt?: string;
    author?: string;
    /** ISO date. Only set on articles, so non-articles emit no article metadata. */
    publishDate?: string;
    /** Page-specific structured data. Without it the page describes the product. */
    jsonLd?: Record<string, unknown> | Record<string, unknown>[];
    /** Keep the page reachable and crawlable, but out of the index. */
    noindex?: boolean;
}

const {
    title,
    description,
    image = '/media/og.png',
    // Travels with . A page that overrides one and not the other
    // describes a picture it is not showing.
    imageAlt = 'OMNI, noise-canceling context and long-term memory for AI coding agents',
    author = 'Fajar Hidayat',
    publishDate,
    jsonLd,
    noindex = false,
} = Astro.props;

const SITE = 'https://omni.weekndlabs.com';
const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE);
const isArticle = Boolean(publishDate);

// Blog posts previously inherited SoftwareApplication schema and a hardcoded
// 2026-06-01 publish date, so 43 URLs claimed to be the same piece of software
// released on the same day. Pages now declare their own.
const defaultJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'OMNI',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Linux, Windows',
    description,
    url: SITE,
    license: 'https://github.com/fajarhide/omni/blob/main/LICENSE',
    codeRepository: 'https://github.com/fajarhide/omni',
    programmingLanguage: 'Rust',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    author: { '@type': 'Person', name: author, url: 'https://github.com/fajarhide' },
};

// "follow" stays on noindex pages so link equity still flows out of them.
// max-snippet:-1 lets AI Overviews quote a full passage rather than a clipped one.
const robots = noindex
    ? 'noindex, follow'
    : 'index, follow, max-snippet:-1, max-image-preview:large';

const structuredData = jsonLd ?? defaultJsonLd;
---

<!doctype html>
{/* data-theme is written before first paint by the script in <head>. The
    attribute starts as light so a reader with JavaScript off gets the paper
    version rather than the design system's bare dark default. */}
<html lang="en" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
        <meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="OMNI summary for AI systems" />

		<meta name="author" content={author} />
		{/* The one place a token has to be written out: this meta takes a colour,
		    not a var. These are --wl-background at each theme. The media queries
		    only track the OS, so a reader who has toggled against it gets browser
		    chrome one shade off. Matching the toggle would need JS to rewrite the
		    tag on every switch, which is more moving parts than the mismatch is
		    worth. */}
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#FAFAFA" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#131316" />

		{/* Before first paint, so the page never flashes the wrong theme. A stored
		    choice wins over the OS; nothing stored means follow the OS. Kept inline
		    and tiny for that reason: a deferred module would run after paint. */}
		<script is:inline>
			(() => {
				let stored = null;
				try { stored = localStorage.getItem('omni-theme'); } catch { /* private mode */ }
				const dark = stored ? stored === 'dark'
					: matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.dataset.theme = dark ? 'dark' : 'light';
			})();
		</script>
		<meta name="robots" content={robots} />

		<!-- Open Graph -->
		<meta property="og:site_name" content="OMNI" />
		<meta property="og:type" content={isArticle ? 'article' : 'website'} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.site || SITE)} />
		{/* Dimensions let a crawler lay out the card before the image lands, which
		    is what stops a shared link rendering as a small thumbnail on first
		    fetch. The alt describes the card itself, not the page, and the card is
		    the same on every URL. */}
		<meta property="og:image:width" content="2400" />
		<meta property="og:image:height" content="1260" />
		<meta property="og:image:alt" content={imageAlt} />
		{isArticle && (
			<Fragment>
				<meta property="article:author" content={author} />
				<meta property="article:published_time" content={publishDate} />
			</Fragment>
		)}

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(image, Astro.site || SITE)} />

		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

        {/* Inter is one variable file carrying every weight the page uses, so
            the seven IBM Plex preloads collapse to one. The mono and the serif
            are below the fold on every route and are left to the stylesheet.
            The URL is imported rather than written out because the file is
            hashed out of node_modules at build time. */}
        <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin>
	</head>
	<body>
		<Navbar />
		<slot />
        <Footer />
        
	</body>
</html>
