---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
    description: string;
    image?: string;
    author?: string;
    /** ISO date. Only set on articles, so non-articles emit no article metadata. */
    publishDate?: string;
    /** Page-specific structured data. Without it the page describes the product. */
    jsonLd?: Record<string, unknown> | Record<string, unknown>[];
    /** Keep the page reachable and crawlable, but out of the index. */
    noindex?: boolean;
}

const {
    title,
    description,
    image = '/media/og.png',
    author = 'Fajar Hidayat',
    publishDate,
    jsonLd,
    noindex = false,
} = Astro.props;

const SITE = 'https://omni.weekndlabs.com';
const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE);
const isArticle = Boolean(publishDate);

// Blog posts previously inherited SoftwareApplication schema and a hardcoded
// 2026-06-01 publish date, so 43 URLs claimed to be the same piece of software
// released on the same day. Pages now declare their own.
const defaultJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'OMNI',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Linux, Windows',
    description,
    url: SITE,
    license: 'https://github.com/fajarhide/omni/blob/main/LICENSE',
    codeRepository: 'https://github.com/fajarhide/omni',
    programmingLanguage: 'Rust',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    author: { '@type': 'Person', name: author, url: 'https://github.com/fajarhide' },
};

// "follow" stays on noindex pages so link equity still flows out of them.
// max-snippet:-1 lets AI Overviews quote a full passage rather than a clipped one.
const robots = noindex
    ? 'noindex, follow'
    : 'index, follow, max-snippet:-1, max-image-preview:large';

const structuredData = jsonLd ?? defaultJsonLd;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
        <meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="OMNI summary for AI systems" />

		<meta name="author" content={author} />
		<meta name="theme-color" content="#E3E4E0" />
		<meta name="robots" content={robots} />

		<!-- Open Graph -->
		<meta property="og:site_name" content="OMNI" />
		<meta property="og:type" content={isArticle ? 'article' : 'website'} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.site || SITE)} />
		{/* Dimensions let a crawler lay out the card before the image lands, which
		    is what stops a shared link rendering as a small thumbnail on first
		    fetch. The alt describes the card itself, not the page, and the card is
		    the same on every URL. */}
		<meta property="og:image:width" content="2400" />
		<meta property="og:image:height" content="1260" />
		<meta property="og:image:alt" content="OMNI, noise-canceling context and long-term memory for AI coding agents" />
		{isArticle && (
			<Fragment>
				<meta property="article:author" content={author} />
				<meta property="article:published_time" content={publishDate} />
			</Fragment>
		)}

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(image, Astro.site || SITE)} />

		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

        {/* IBM Plex is served from this origin now, declared in global.css.
            Only the two faces above the fold are preloaded: the condensed 700
            the headline is set in, and the body 400. Preloading all seven would
            put five unused files ahead of the ones that block first paint. */}
        <link rel="preload" href="/fonts/ibm-plex-sans-condensed-700.woff2" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="/fonts/ibm-plex-sans-400.woff2" as="font" type="font/woff2" crossorigin>
	</head>
	<body>
		<Navbar />
		<slot />
        <Footer />
        
	</body>
</html>
