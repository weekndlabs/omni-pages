---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
    description: string;
    image?: string;
    author?: string;
    /** ISO date. Only set on articles, so non-articles emit no article metadata. */
    publishDate?: string;
    /** Page-specific structured data. Without it the page describes the product. */
    jsonLd?: Record<string, unknown> | Record<string, unknown>[];
    /** Keep the page reachable and crawlable, but out of the index. */
    noindex?: boolean;
}

const {
    title,
    description,
    image = '/media/og.png',
    author = 'Fajar Hidayat',
    publishDate,
    jsonLd,
    noindex = false,
} = Astro.props;

const SITE = 'https://omni.weekndlabs.com';
const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE);
const isArticle = Boolean(publishDate);

// Blog posts previously inherited SoftwareApplication schema and a hardcoded
// 2026-06-01 publish date, so 43 URLs claimed to be the same piece of software
// released on the same day. Pages now declare their own.
const defaultJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'OMNI',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Linux, Windows',
    description,
    url: SITE,
    license: 'https://github.com/fajarhide/omni/blob/main/LICENSE',
    codeRepository: 'https://github.com/fajarhide/omni',
    programmingLanguage: 'Rust',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    author: { '@type': 'Person', name: author, url: 'https://github.com/fajarhide' },
};

// "follow" stays on noindex pages so link equity still flows out of them.
// max-snippet:-1 lets AI Overviews quote a full passage rather than a clipped one.
const robots = noindex
    ? 'noindex, follow'
    : 'index, follow, max-snippet:-1, max-image-preview:large';

const structuredData = jsonLd ?? defaultJsonLd;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
        <meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="OMNI summary for AI systems" />

		<meta name="author" content={author} />
		<meta name="theme-color" content="#E3E4E0" />
		<meta name="robots" content={robots} />

		<!-- Open Graph -->
		<meta property="og:site_name" content="OMNI" />
		<meta property="og:type" content={isArticle ? 'article' : 'website'} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.site || SITE)} />
		{isArticle && (
			<Fragment>
				<meta property="article:author" content={author} />
				<meta property="article:published_time" content={publishDate} />
			</Fragment>
		)}

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(image, Astro.site || SITE)} />

		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Sans+Condensed:wght@600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
	</head>
	<body>
		<Navbar />
		<slot />
        <Footer />
        
	</body>
</html>
