---
import Layout from '../layouts/Layout.astro';
import { getBenchmarkStats, extremes } from '../lib/readme-stats.js';
import { getReleases } from '../lib/changelog.js';
import { loadReels } from '../lib/demo.js';

const GITHUB_REPO = 'https://github.com/fajarhide/omni';
const GITHUB_RELEASES = `${GITHUB_REPO}/releases`;

/* The CHANGELOG the /releases page already parses, rather than a literal that
   went stale (it read v0.6.9 seven releases later) whenever the GitHub API
   rate-limited the build. The script at the bottom still refreshes it live. */
const { releases } = await getReleases();
const latestVersion = `v${releases[0].version}`;

// Benchmark figures are read from the OMNI manual on `main` at build time.
// Do not hardcode them here. See src/lib/readme-stats.js.
const stats = await getBenchmarkStats();
const { best, worst } = extremes(stats.rows);

/* Real fixtures run through a real `omni exec`, see scripts/make-demo.sh. The
   page used to show lines written by hand under a caption saying they were
   reproducible, which is fabricated output in the first screen of a tool whose
   pitch is that it never fabricates output. */
const { version: demoVersion, reels } = loadReels();
const tallestReel = Math.max(...reels.map((r) => r.rawLines.length));
const gs = reels.find((r) => r.name === 'git-status');

const installs = [
	{ label: 'macOS, Linux', cmd: 'brew install fajarhide/tap/omni' },
	{ label: 'Any Unix', cmd: 'curl -fsSL omni.weekndlabs.com/install | bash' },
	{ label: 'Windows', cmd: 'irm omni.weekndlabs.com/install.ps1 | iex' },
];

/* What it does. One row per behaviour, each with the receipt that proves it
   where one exists. The latency row is quiet because it is a cost, and it is
   on the page because a tool that sits on every command should say what it
   charges. "21 to 61 ms" deliberately lags an 11.1 ms A/B in the manual, see
   project memory; move the manual first. */
const does = [
	{
		k: 'Drops noise',
		v: 'A distiller written for the command keeps errors, stack frames and what changed, and drops progress bars, passing tests and the hints git prints every time. If it cannot parse the output, it hands it back untouched rather than guessing.',
		proof: { label: 'issue 143', href: `${GITHUB_REPO}/issues/143` },
	},
	{
		k: 'Folds repeats',
		v: 'Output the agent has already been shown this session comes back as one marker with a handle, because those bytes are already in its context. A file it asks to read is always delivered whole. When the context compacts, OMNI forgets what it had shown.',
	},
	{
		k: 'Keeps everything',
		v: 'Everything cut is archived to local SQLite keyed by SHA-256, for inputs up to 64 KB, and <code>omni retrieve</code> prints it back on any host. Above that size the marker says so. Handles last a rolling 30 days.',
		proof: { label: 'issue 271', href: `${GITHUB_REPO}/issues/271` },
	},
	{
		k: 'Leaves failures alone',
		v: `A command that exits non-zero reaches the agent whole, and JSON, YAML, NDJSON and CSV go through byte for byte. Most commands are not touched at all: ${stats.zeroSaveShare} in the current benchmark, with zero bytes added.`,
		proof: { label: 'issue 120', href: `${GITHUB_REPO}/issues/120` },
	},
	{
		k: 'Remembers the project',
		v: '<code>omni remember</code> stores rules and gotchas, <code>omni goal</code> restates the objective on every prompt, and a new session, or a new editor, starts with a summary of the last one.',
	},
	{
		k: 'What it costs',
		v: 'About 21 ms per hooked command on a fresh database and about 61 ms against a 205 MB one, growing with your history rather than with the output. Budget for it.',
		quiet: true,
	},
];

/* Straight from the README's "What each host lets OMNI do". The tiers are a
   support claim, so they are copied rather than paraphrased: a host listed one
   tier too high is the site promising shell distillation the host cannot do.
   Check against the README on main before editing, and against `omni doctor`,
   which prints the tier for every installed host. */
const hosts = [
	{
		k: 'Full',
		names: 'Claude Code, Codex CLI, Gemini CLI, Aider (pipe)',
		v: "The host applies OMNI's rewrite, so the model reads distilled output from its own built-in tools.",
	},
	{
		k: 'Handoff-first',
		names: 'Cursor, Windsurf',
		v: 'The host cannot rewrite built-in tool output. <code>omni_run</code> distils anything you route through it, and <code>omni init --cursor</code> installs the rule that makes the agent reach for it.',
	},
	{
		k: 'MCP-only',
		names: 'Cline, Roo, OpenCode, VS Code, Zed, Copilot, Antigravity, Hermes, Pi',
		v: 'Memory, recall and session state. No shell distillation, and no claim of it.',
	},
];

/* A subset of `omni help`. Every entry exists in the released binary: run
   `omni <cmd> --help` against an installed build before adding one, because
   three commands taken from docs/ once turned out not to exist. */
const commands = [
	{ k: 'omni init', v: 'Wire the hook and the MCP server into your agent. Interactive.' },
	{ k: 'omni doctor --fix', v: 'Check the hooks and the MCP wiring, then repair whatever is broken.' },
	{ k: 'omni stats', v: 'What it actually saved on your machine, and from which commands.' },
	{ k: 'omni retrieve', v: 'Print what a marker archived, by the 16 characters inside it.' },
	{ k: 'omni reset', v: 'Take it back out. Clean uninstall, keeping a backup of your config.' },
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'OMNI',
	alternateName: 'OMNI context engine',
	applicationCategory: 'DeveloperApplication',
	applicationSubCategory: 'Command line tool',
	operatingSystem: 'macOS, Linux, Windows',
	description: 'A shell hook for AI coding agents. Trims command output the model does not need, folds output it has already seen into a handle, and archives every byte it cuts.',
	url: 'https://omni.weekndlabs.com',
	downloadUrl: GITHUB_RELEASES,
	codeRepository: GITHUB_REPO,
	programmingLanguage: 'Rust',
	license: `${GITHUB_REPO}/blob/main/LICENSE`,
	softwareVersion: latestVersion.replace(/^v/, ''),
	isAccessibleForFree: true,
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	author: { '@type': 'Person', name: 'Fajar Hidayat', url: 'https://github.com/fajarhide' },
	featureList: [
		'Distills noisy terminal output before it reaches the model',
		'Archives everything it removes to a local SQLite store, retrievable by hash',
		'Passes failing commands and structured data through untouched',
		'Carries project memory across sessions and across editors',
		'Runs as an MCP server and a shell hook',
	],
};
---

<Layout
	title="OMNI, less noise in your coding agent's context"
	description="Free Rust CLI for AI coding agents. Trims command output the model does not need, folds what it has already seen into a handle, and archives every byte it cuts."
	jsonLd={jsonLd}
>
	<main>
		<section class="hero">
			<div class="wrap">
				<div class="hero-grid">
					<div class="hero-copy">
						{/* No percentage up here. The figure moves twentyfold between two
						    weeks of the same developer's work, so the one claim that holds
						    on any workload is what OMNI will and will not do. The numbers
						    are further down, with their corpus beside them. */}
						<h1 class="t-display">Your agent reads less noise, and loses nothing<span class="text-brand">.</span></h1>

						<p class="lede">
							OMNI is a shell hook for coding agents. It trims command output the model does not need, replaces output the model has already seen with a short marker, and archives everything it cuts so <code>omni retrieve</code> can print it again. A command that fails reaches the model whole.
						</p>

						<div class="hero-actions">
							<a href={GITHUB_REPO} class="btn btn-solid" target="_blank" rel="noopener noreferrer">
								<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
								Read the source
							</a>
							<a href="#numbers" class="btn btn-ghost">See the numbers</a>
						</div>

					</div>

					<div class="hero-demo">
						<p class="release">
							<span class="release-dot" aria-hidden="true"></span>
							<span id="omni-version">{latestVersion}</span>
							<span aria-hidden="true">/</span>
							<span id="omni-status" data-status="stable">Stable</span>
						</p>

						{/* The signature: the raw output, then the noise struck through and
						    collapsed, then what the agent actually received. The third reel
						    is a failing run, and nothing happens to it. That is the promise
						    the rest of the page makes, shown rather than told. */}
						<figure class="crt" id="demo">
							<figcaption class="crt-bar">
								<span class="crt-case" id="reel-label">{reels[0].label}</span>
								<span class="crt-read">
									<span class="crt-phase" id="phase">raw</span>
									<span class="crt-meter" id="meter">{reels[0].inBytes}</span>
								</span>
							</figcaption>
							<div class="crt-body" style={`--rows:${tallestReel}`}>
								{reels.map((r, ri) => (
									<div class="reel" data-reel={ri} hidden={ri !== 0}>
										<div class="raw">
											{r.rawLines.map((line, li) => (
												<div class={`ln${line.skip ? ' ln-skip' : ''}`} style={`--i:${li}`}><span class="mark" aria-hidden="true">{line.prompt ? '$' : ' '}</span><span class="txt">{line.t}</span></div>
											))}
										</div>
										<div class="out">
											{r.outLines.map((line) => (
												<div class="ln"><span class="mark" aria-hidden="true">+</span><span class="txt">{line.t}</span></div>
											))}
										</div>
									</div>
								))}
							</div>
							<div class="crt-foot">
								<span id="reel-saved">{reels[0].verdict}</span>
								<span>exit {reels[0].exit}, real output from omni exec {demoVersion}</span>
							</div>
						</figure>
						<p class="crt-cap">
							Fixtures from <code>tests/fixtures/</code>, long ones shortened where marked: <span id="reel-cap">{reels[0].cap}</span>
						</p>
					</div>
					<div class="hero-install">
					{/* All three installers are printed. The curl and PowerShell ones
					    used to sit behind link-styled buttons, so a reader pasted a
					    pipe-to-shell command they had never seen. */}
					<div class="install">
						{installs.map((i) => (
							<div class="install-row">
								<span class="sigil" aria-hidden="true">$</span>
								<code>{i.cmd}</code>
								<span class="install-os">{i.label}</span>
								<button class="copy" type="button" data-copy={i.cmd} aria-label={`Copy: ${i.cmd}`}>
									<svg class="i-copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
									<svg class="i-ok" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
								</button>
							</div>
						))}
						<p class="install-alt">Then <code>omni init</code>. <span id="copy-status" role="status" aria-live="polite"></span></p>
					</div>
					</div>
				</div>
			</div>
		</section>

		{/* RHYTHM 2: Why and Numbers are the two sections that break the
		    heading-plus-rows shape. The example is static and on paper, because
		    the page has one instrument and it is the one that animates. */}
		<section class="band band-sunk" id="why">
			<div class="wrap split">
				<header class="band-head">
					<span class="eyebrow">Why</span>
					<h2 class="t-section">Your agent pays to read every line a command prints</h2>
					<p class="lede">
						Progress bars, a few hundred passing tests, the same git hints every time, a file it read ten minutes ago. Each line costs tokens and pushes something useful further back in the context window. Some of it is noise, and some of it the agent is already holding.
					</p>
				</header>

				<figure class="pair">
					<div class="pair-side">
						<p class="pair-h"><span>What <code>git status</code> printed</span> <span class="pair-n">{gs.inBytes}</span></p>
						<pre class="pair-body pair-raw">{gs.rawText}</pre>
					</div>
					<div class="pair-side">
						<p class="pair-h"><span>What the agent read</span> <span class="pair-n">{gs.outBytes}</span></p>
						<pre class="pair-body">{gs.outText}</pre>
					</div>
					<figcaption class="fine">
						The <code>git_status_dirty.txt</code> fixture through <code>omni exec</code> {demoVersion}. The handle in the last line prints the original back.
					</figcaption>
				</figure>
			</div>
		</section>

		<section class="band" id="what">
			<div class="wrap">
				<header class="band-head">
					<span class="eyebrow">What it does</span>
					<h2 class="t-section">Five things on every command, and one cost</h2>
				</header>

				<dl class="rows">
					{does.map((r) => (
						<div class={`row${r.quiet ? ' row-quiet' : ''}`}>
							<dt class="row-k">{r.k}</dt>
							<dd class="row-v">
								<span set:html={r.v} />
								{r.proof && (
									<Fragment>
										{' '}
										<span class="receipt">
											<a href={r.proof.href} target="_blank" rel="noopener noreferrer">{r.proof.label}</a>
										</span>
									</Fragment>
								)}
							</dd>
						</div>
					))}
				</dl>

				<p class="fine fine-after">
					If OMNI panics, it fails open: the raw output passes through and your agent never notices.
				</p>
			</div>
		</section>

		<section class="band band-sunk" id="hosts">
			<div class="wrap">
				<header class="band-head">
					<span class="eyebrow">Where it works</span>
					<h2 class="t-section">What each agent lets OMNI do</h2>
					<p class="lede">
						Only a host that can rewrite its own tool output gets shell distillation. The rest get memory, and no claim of more. <code>omni doctor</code> prints the tier for every host you have installed.
					</p>
				</header>

				<dl class="rows">
					{hosts.map((h) => (
						<div class="row">
							<dt class="row-k">{h.k}</dt>
							<dd class="row-v">
								<span class="host-names">{h.names}</span>
								<span set:html={h.v} />
							</dd>
						</div>
					))}
				</dl>
			</div>
		</section>

		<section class="band" id="numbers">
			<div class="wrap split">
				<header class="band-head">
					<span class="eyebrow">Numbers</span>
					<h2 class="t-section">{stats.overallSaved} fewer bytes on the current benchmark, and why that is low</h2>
					<p class="lede">
						{stats.totalCalls} commands from one developer's week, replayed on the release binary: {stats.filtersSaved} from the distillers, {stats.overallSaved} once the ledger folds repeats, and {stats.zeroSaveShare} of calls left untouched. That week was mostly short shell plumbing with little to cut. The figure moves a lot with the workload, which is why the manual publishes every run, including the ones that read worse.
					</p>
				</header>

				<div>
				<div class="ledger-wrap">
					<table class="ledger">
						<caption>
							Read from the manual on main at build time, so the two cannot drift apart. Best class {best.command} at {best.savings}, worst {worst.command} at {worst.savings}.
						</caption>
						<thead>
							<tr>
								<th scope="col">Class</th>
								<th scope="col">Calls</th>
								<th scope="col">In</th>
								<th scope="col">Filters</th>
								<th scope="col">With ledger</th>
							</tr>
						</thead>
						<tbody>
							{stats.rows.map((row) => (
								<tr>
									<th scope="row"><code>{row.command}</code></th>
									<td class="n">{row.calls}</td>
									<td class="n">{row.input}</td>
									<td class="n">{row.filters}</td>
									{/* Scaled to the best row, so the bars compare classes
									    rather than all sitting at a few pixels wide. */}
									<td class="saved"><span class="bar" style={`--w:${(row.pct / best.pct) * 100}%`}><span>{row.savings}</span></span></td>
								</tr>
							))}
						</tbody>
					</table>
				</div>

				{/* No figures from the head-to-head here. They are not parsed, and a
				    hardcoded comparison beside a parsed trace count is how this
				    paragraph once credited one corpus's result to another. */}
				<p class="fine fine-after">
					The manual also replays rtk, lean-ctx, caveman and headroom on the same bytes and publishes every arm, including the ones where OMNI loses.
					{' '}
					<span class="receipt"><a href="/docs/develop/benchmarks">benchmarks</a></span>
					{' '}Run <code>omni stats</code> for your own.
				</p>
				</div>
			</div>
		</section>

		<section class="band band-sunk" id="start">
			<div class="wrap">
				<header class="band-head">
					<span class="eyebrow">Commands</span>
					<h2 class="t-section">Apache 2.0, no account, no paid tier</h2>
					<p class="lede">
						Everything runs on your machine. If it saves you nothing, <code>omni stats</code> will say so and <code>omni reset</code> removes it. <code>omni help</code> lists the rest.
					</p>
				</header>

				<dl class="rows">
					{commands.map((c) => (
						<div class="row">
							<dt class="row-k is-mono">{c.k}</dt>
							<dd class="row-v" set:html={c.v} />
						</div>
					))}
				</dl>

				<p class="fine fine-after">
					There are no filters to write. The pattern layer was retired in 0.7.4, and what runs is the Rust distillers and the ledger, compiled in. If a tool needs handling, open an issue and it ships in the binary.
				</p>

				<div class="hero-actions close-actions">
					<a href={GITHUB_REPO} class="btn btn-solid" target="_blank" rel="noopener noreferrer">Read the source</a>
					<a href={GITHUB_RELEASES} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">Release notes</a>
				</div>
			</div>
		</section>
	</main>

	<script define:vars={{ reels: reels.map(({ label, exit, inBytes, outBytes, verdict, cap, passed, rawLines }) => ({ label, exit, inBytes, outBytes, verdict, cap, passed, rows: rawLines.length })), demoVersion }}>
		const demo = document.getElementById('demo');
		const el = (id) => document.getElementById(id);
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		function setPhase(label, on) {
			const phase = el('phase');
			phase.textContent = label;
			if (on) phase.setAttribute('data-on', '');
			else phase.removeAttribute('data-on');
		}

		function show(i) {
			demo.querySelectorAll('.reel').forEach((r) => {
				r.hidden = Number(r.dataset.reel) !== i;
			});
			const r = reels[i];
			el('reel-label').textContent = r.label;
			el('reel-saved').textContent = r.verdict;
			el('reel-cap').textContent = r.cap;
			el('meter').textContent = r.inBytes;
			demo.querySelector('.crt-foot span:last-child').textContent = `exit ${r.exit}, real output from omni exec ${demoVersion}`;
		}

		// The verdict for one reel. A failing run is never struck: the phase just
		// says what OMNI did with it, which was nothing.
		function settle(i) {
			const r = reels[i];
			if (r.passed) {
				setPhase('passed through', true);
				return;
			}
			demo.classList.add('scoring', 'cut');
			setPhase('distilled', true);
			el('meter').textContent = r.outBytes;
		}

		if (demo && reduced) {
			settle(0);
		} else if (demo) {
			let onScreen = false;
			new IntersectionObserver(
				(entries) => entries.forEach((e) => { onScreen = e.isIntersecting; }),
				{ threshold: 0.25 }
			).observe(demo);

			const wait = (ms) => new Promise((r) => setTimeout(r, ms));

			(async () => {
				for (let i = 0; ; i = (i + 1) % reels.length) {
					while (!onScreen) await wait(400);
					show(i);
					setPhase('raw', false);
					await wait(1600);                          // the output as the shell wrote it
					if (reels[i].passed) {
						setPhase(`exit ${reels[i].exit}`, true);
						await wait(1400);
						settle(i);
						await wait(4200);
						continue;
					}
					demo.classList.add('scoring');
					setPhase('scoring', true);
					await wait(reels[i].rows * 90 + 400);       // the strike walks every line
					settle(i);
					await wait(4200);                          // hold on what the agent got
					demo.classList.remove('scoring', 'cut');
					setPhase('raw', false);
					await wait(700);
				}
			})();
		}

		// Copy buttons. Success is shown only once the clipboard has said yes; the
		// old handler showed a tick before the promise settled, so a denied write
		// still read as copied.
		const status = el('copy-status');
		document.querySelectorAll('[data-copy]').forEach((btn) => {
			btn.addEventListener('click', async () => {
				const text = btn.dataset.copy;
				let ok = true;
				try {
					await navigator.clipboard.writeText(text);
				} catch {
					ok = false;
				}
				btn.dataset.state = ok ? 'ok' : 'fail';
				status.textContent = ok ? 'Copied.' : 'Copy failed. Select the command and copy it by hand.';
				clearTimeout(btn._t);
				btn._t = setTimeout(() => {
					delete btn.dataset.state;
					status.textContent = '';
				}, ok ? 1800 : 6000);
			});
		});

		// Keep the release badge current between deploys.
		fetch('https://api.github.com/repos/fajarhide/omni/releases/latest')
			.then((r) => (r.ok ? r.json() : null))
			.then((data) => {
				if (!data) return;
				const v = el('omni-version');
				const s = el('omni-status');
				if (v && data.tag_name !== v.textContent) {
					v.textContent = data.tag_name;
					const tag = data.tag_name;
					const label = tag.includes('-rc') ? 'Release candidate'
						: tag.includes('-alpha') ? 'Alpha'
						: tag.includes('-beta') ? 'Beta'
						: 'Stable';
					if (s) {
						s.textContent = label;
						s.setAttribute('data-status', label.toLowerCase().replace(' ', '-'));
					}
				}
			})
