						</div>
					))}
					{promises.map((r) => (
						<div class="row">
							<dt class="row-k">{r.k}</dt>
							{/* set:html, the same as every other row on this page. This one
							    cell interpolated the string raw, so the Reversible row printed
							    its own code tags as visible text. */}
							<dd class="row-v">
								<span set:html={r.v} />
								{' '}
								<span class="receipt">
