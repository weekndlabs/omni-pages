---
import Layout from '../layouts/Layout.astro';
import { getBenchmarkStats, extremes } from '../lib/readme-stats.js';

const GITHUB_REPO = 'https://github.com/fajarhide/omni';
const GITHUB_RELEASES = `${GITHUB_REPO}/releases`;

const getVersionLabel = (version) => {
	if (version.includes('-rc')) return 'Release candidate';
	if (version.includes('-alpha')) return 'Alpha';
	if (version.includes('-beta')) return 'Beta';
	return 'Stable';
};

let latestVersion = 'v0.6.6';
let versionLabel = getVersionLabel(latestVersion);

try {
	const response = await fetch('https://api.github.com/repos/fajarhide/omni/releases/latest');
	if (response.ok) {
		const data = await response.json();
		latestVersion = data.tag_name;
		versionLabel = getVersionLabel(latestVersion);
	}
} catch (e) {
	console.error('Failed to fetch latest OMNI version:', e);
}

// Benchmark figures are read from the OMNI README on `main` at build time.
// Do not hardcode them here. See src/lib/readme-stats.js.
const stats = await getBenchmarkStats();
const { best, worst } = extremes(stats.rows);
const workingShare = (100 - parseFloat(stats.zeroSaveShare)).toFixed(1) + '%';

/* Hero demo. Three real command shapes, with the lines OMNI drops marked so the
   block can subtract them in place. `n` is the noise flag, `keep` highlights the
   part that survives. Every byte figure comes from the README fixture table, and
   the three are chosen to span the range on purpose: a command that pays for
   itself, an ordinary one, and one that barely does. A page arguing against fake
   90% claims cannot show three 90% demos. */
const cargoTest = [
	{ t: '$ cargo test', prompt: true },
	{ t: '   Compiling omni v0.6.0 (/Users/f/omni)', n: true },
	{ t: '   Compiling serde v1.0.210', n: true },
	{ t: '   Compiling regex v1.10.6', n: true },
	{ t: '    Finished test profile in 41.20s', n: true },
	{ t: '     Running unittests src/lib.rs', n: true },
	{ t: 'test pipeline::score::keeps_stack_frames ... ok', n: true },
	{ t: 'test pipeline::score::drops_progress_bars ... ok', n: true },
	{ t: 'test pipeline::format::json_passthrough ... ok', n: true },
	{ t: 'test rewind::store::roundtrip_sha256 ... ok', n: true },
	{ t: 'test rewind::store::retrieve_by_hash ... ok', n: true },
	{ t: '... 478 more passing tests ...', n: true },
	{ t: 'test distill::cargo::parses_summary ... FAILED', keep: true },
	{ t: '', n: true },
	{ t: 'failures:' },
	{ t: '    thread panicked at src/distill/cargo.rs:118:9', keep: true },
	{ t: '    assertion `left == right` failed' },
	{ t: '      left: 490' },
	{ t: '     right: 500' },
	{ t: '', n: true },
	{ t: 'test result: FAILED. 490 passed; 10 failed', keep: true },
];

/* The six hint lines git prints every single time, gone. What changed, stays. */
const gitStatus = [
	{ t: '$ git status', prompt: true },
	{ t: 'On branch main' },
	{ t: "Your branch is ahead of 'origin/main' by 2 commits." },
	{ t: '  (use "git push" to publish your local commits)', n: true },
	{ t: '', n: true },
	{ t: 'Changes not staged for commit:' },
	{ t: '  (use "git add <file>..." to update what will be committed)', n: true },
	{ t: '  (use "git restore <file>..." to discard changes)', n: true },
	{ t: '        modified:   src/pipeline/score.rs', keep: true },
	{ t: '        modified:   src/distill/cargo.rs', keep: true },
	{ t: '', n: true },
	{ t: 'Untracked files:' },
	{ t: '  (use "git add <file>..." to include in what will be committed)', n: true },
	{ t: '        tests/fixtures/docker-build.txt', keep: true },
	{ t: '', n: true },
	{ t: 'no changes added to commit (use "git add" to track them)', n: true },
];

/* The honest one. A successful build is mostly layer bookkeeping, but the
   bookkeeping is only a third of the bytes, so a third is all it saves. */
const dockerBuild = [
	{ t: '$ docker build -t omni:ci .', prompt: true },
	{ t: '#1 [internal] load build definition from Dockerfile' },
	{ t: '#1 transferring dockerfile: 412B done', n: true },
	{ t: '#1 DONE 0.0s', n: true },
	{ t: '#2 [internal] load .dockerignore' },
	{ t: '#2 transferring context: 108B done', n: true },
	{ t: '#2 DONE 0.0s', n: true },
	{ t: '#3 [internal] load metadata for docker.io/library/rust:1.79' },
	{ t: '#3 DONE 1.2s', n: true },
	{ t: '#4 [builder 1/5] FROM docker.io/library/rust:1.79' },
	{ t: '#4 CACHED' },
	{ t: '#5 [internal] load build context' },
	{ t: '#5 transferring context: 2.14MB done', n: true },
	{ t: '#5 DONE 0.3s', n: true },
	{ t: '#8 [builder 4/5] RUN cargo build --release' },
	{ t: '#8 24.61 warning: unused import: `std::fmt`', keep: true },
	{ t: '#8 24.61   --> src/rewind/store.rs:4:5', keep: true },
	{ t: '#8 DONE 61.4s', n: true },
	{ t: '#9 exporting to image' },
	{ t: '#9 writing image sha256:9f2c1a3e8b04', keep: true },
	{ t: '#9 naming to docker.io/library/omni:ci done', keep: true },
];

/* Noise lines get an ordinal so the strike can walk down the block one line at
   a time. That walk is the whole point: it shows the scoring pass happening. */
const reel = (lines) => {
	let n = 0;
	return lines.map((line) => ({ ...line, i: line.n ? n++ : null }));
};

const fx = stats.fixtures;

/* One entry per command in the reel. `cap` is the measurement, `cut` and `kept`
   are what the strike is doing while you watch it, so the block explains itself
   instead of just looking busy. */
const demos = [
	{
		fixture: fx['cargo test'],
		lines: reel(cargoTest),
		cap: `${fx['cargo test'].input} of test output becomes ${fx['cargo test'].output}, a ${fx['cargo test'].savings} cut.`,
		cut: 'The compile log, the timing footer, and 478 passing tests. A test that passed tells your agent nothing it can act on.',
		kept: 'The one test that failed, the panic and its file and line, and the runner\'s own result line. The count is copied, never recomputed.',
	},
	{
		fixture: fx['git status'],
		lines: reel(gitStatus),
		cap: `${fx['git status'].input} becomes ${fx['git status'].output}, a ${fx['git status'].savings} cut on a command your agent runs constantly.`,
		cut: 'The four hint lines git reprints identically on every single call, explaining add, restore and push to a reader who already knows.',
		kept: 'The branch, how far ahead it is, both modified paths and the untracked file. Every byte that differs from the last run stays.',
	},
	{
		fixture: fx['docker build'],
		lines: reel(dockerBuild),
		cap: `${fx['docker build'].input} becomes ${fx['docker build'].output}, a ${fx['docker build'].savings} cut, and that is the honest end of the range.`,
		cut: 'Per layer bookkeeping: transferring context, DONE 0.0s, the timings nobody reads on a build that worked.',
		kept: 'Every stage header, the compiler warning with its file and line, and the image digest. Two thirds of a green build is still worth reading.',
	},
];

/* The bar names the case with the context string straight out of the README
   fixture table ("490 passed, 10 failed", "dirty", "heavy noise"), so the label
   is a parsed measurement rather than one more claim to keep true. The position
   tells a reader who lands mid cycle that two more cases are coming. */
demos.forEach((d, i) => {
	// Split at the parenthetical so a narrow bar can drop the context rather than
	// truncate it mid word. "1 of 3 · cargo test" survives on its own.
	const [, cmd, ctx = ''] = d.fixture.command.match(/^([^(]+)(\(.*\))?$/);
	d.label = `${i + 1} of ${demos.length} · ${cmd.trim()}`;
	d.context = ctx;
});

/* The reel switches between blocks of different length, so the body is pinned to
   the tallest. Nothing on the page may move while it plays. */
const tallestReel = Math.max(...demos.map((d) => d.lines.length));

/* Limits first, then promises. Same row shape, so they read as one ledger. */
const limits = [
	{
		k: stats.zeroSaveShare,
		sub: 'of all calls',
		v: `saved nothing at all. Across ${stats.totalCalls} replayed executions close to two thirds went straight back, zero bytes added, zero removed. All of the ${stats.overallSaved} headline comes from the other ${workingShare}.`,
	},
	{
		k: '82 to 308 ms',
		sub: 'per hooked command',
		v: 'and the cost grows with your history. A 496 byte <code>git status</code> takes about 82ms against a fresh database and about 308ms against a 97 MB one. A 16.5 KB <code>cargo test</code> takes about 276ms. Budget for it.',
	},
	{
		k: 'exit != 0',
		sub: 'never compressed',
		v: 'Failing commands pass through whole, structured output is never touched, and a distiller that cannot parse its input stays quiet instead of guessing.',
	},
];

const promises = [
	{
		k: 'Reversible',
		v: 'Everything cut is archived to local SQLite keyed by SHA-256. Your agent gets the hash and calls it back when it wants the rest.',
		proof: { label: 'omni_retrieve', href: `${GITHUB_REPO}#how-it-works` },
	},
	{
		k: 'Never invents',
		v: 'A distiller that parsed no signal hands back the raw output. It will not write a green "no errors" line that nothing supports.',
		proof: { label: 'issue 143', href: `${GITHUB_REPO}/issues/143` },
	},
	{
		k: 'Never hides',
		v: 'Any command that exits non-zero passes through untouched. A buried error costs more than an uncompressed one.',
		proof: { label: 'issue 120', href: `${GITHUB_REPO}/issues/120` },
	},
	{
		k: 'Never mangles',
		v: 'JSON, YAML, NDJSON and CSV go through byte for byte, because a corrupted payload costs more than a missed compression.',
		proof: { label: 'pipeline::format', href: `${GITHUB_REPO}/tree/main/src/pipeline` },
	},
];

const memory = [
	{
		k: 'New session',
		was: 'You re-explain the project layout, which module is broken, and that it is Postgres rather than MySQL.',
		now: 'The agent already has it. You carry on from where you stopped.',
	},
	{
		k: 'Bug you already fixed',
		was: 'The agent walks into the same framework quirk it solved yesterday, because nothing kept the answer.',
		now: 'The agent pulls the stored fix back through omni_recall before it repeats the mistake.',
	},
	{
		k: 'Cursor to Claude Code',
		was: 'New editor, new agent, no context. You start over.',
		now: 'The session summary is injected on the way in. The new agent is current.',
	},
	{
		k: 'Agent drifts off task',
		was: 'Three prompts later it is refactoring something you never asked about.',
		now: 'omni goal restates the objective on every prompt.',
	},
];

/* Every entry below exists in BOTH the released binary and main.
 *
 * Do not add a command from docs/ without running `omni <cmd> --help` against an
 * installed build first. Two entries here were wrong: `omni trust` is documented
 * in HOW_TO_USE.md but the binary answers "unknown command", and `omni rewind`
 * shipped in v0.6.3 then got deleted on main, so it would have broken at the
 * next release. Retrieval is the omni_retrieve MCP tool, not a subcommand.
 */
const commands = [
	{ k: 'omni init', v: 'Wire the hook into Claude Code, Cursor, Windsurf, Codex or Antigravity. Interactive.' },
	{ k: 'omni doctor --fix', v: 'Check hooks, MCP wiring and filter cost, then repair whatever is broken.' },
	{ k: 'omni stats', v: 'What it actually saved on your machine. Takes <code>--today</code>, <code>--week</code>, <code>--month</code>.' },
	{ k: 'omni diff', v: 'The last raw input beside what the agent received. This is how you check its work.' },
	{ k: 'omni session --status', v: 'Context pressure, stored engrams, and the errors still open in this session.' },
	{ k: 'omni learn --discover', v: 'Read your shell history and propose filters for your own internal tools.' },
	{ k: 'omni goal', v: 'Set the objective once. OMNI restates it on every prompt so the agent stops drifting.' },
	{ k: 'omni remember', v: 'Store a project rule or a gotcha in local SQLite. Recalled by semantic search later.' },
	{ k: 'omni reset', v: 'Take it back out. Clean uninstall, keeping a backup of your config.' },
];

/* Questions people actually ask before installing something that sits between
   their agent and their terminal. Answers are kept to roughly 40 to 60 words so
   they survive extraction into an AI answer without losing their meaning. */
const faq = [
	{
		q: 'Does OMNI delete my logs?',
		a: 'No. Everything it cuts is compressed and archived to a local SQLite store, keyed by SHA-256. Your agent receives the hash and pulls the full original back whenever it needs it, through the omni_retrieve MCP tool. Nothing is deleted and nothing leaves your machine.',
	},
	{
		q: 'Will it slow down my terminal?',
		a: `Yes, measurably. OMNI runs on every hooked command and the cost grows with your history. A 496 byte git status takes about 82ms against a fresh database and about 308ms against a 97 MB one. A 16.5 KB cargo test takes about 276ms.`,
	},
	{
		q: 'How much does it actually save?',
		a: `${stats.overallSaved} fewer bytes across ${stats.totalCalls} replayed real commands. That average hides a lot: ${stats.zeroSaveShare} of those commands saved nothing at all. The whole saving comes from the remaining ${workingShare}, mostly ${best.command} and other noisy tooling.`,
	},
	{
		q: 'Can it hide an error from my agent?',
		a: 'No. Any command that exits non-zero passes through verbatim, uncompressed. Structured output such as JSON, YAML, NDJSON and CSV is never touched. A distiller that cannot parse its input returns the raw output rather than summarising it.',
	},
	{
		q: 'Which agents does it work with?',
		a: 'Claude Code, Cursor, Windsurf, Roo Code, OpenAI Codex and Antigravity. It installs as a shell hook rather than a wrapper, so you keep typing the commands you already type and nothing about your workflow changes.',
	},
	{
		q: 'Can I add filters for my own tools?',
		a: 'Yes. Filters are TOML files in ~/.omni/signals/ that match a command by regex and strip lines by pattern. You can write them by hand, or run omni learn --discover to have OMNI read your shell history and draft them from the noise it already sees.',
	},
	{
		q: 'What does OMNI cost?',
		a: 'Nothing. It is MIT licensed with no paid tier, no account and no telemetry. If it saves you nothing, omni stats will tell you so and omni reset removes it.',
	},
];

// Product plus FAQ. Both describe this page, so both belong in its graph.
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: 'OMNI',
		alternateName: 'OMNI context engine',
		applicationCategory: 'DeveloperApplication',
		applicationSubCategory: 'Command line tool',
		operatingSystem: 'macOS, Linux, Windows',
		description: 'Noise-canceling context and long-term memory for AI coding agents. Cuts terminal noise before the agent reads it, and remembers your project between sessions.',
		url: 'https://omni.weekndlabs.com',
		downloadUrl: 'https://github.com/fajarhide/omni/releases',
		codeRepository: 'https://github.com/fajarhide/omni',
		programmingLanguage: 'Rust',
		license: 'https://github.com/fajarhide/omni/blob/main/LICENSE',
		softwareVersion: latestVersion.replace(/^v/, ''),
		isAccessibleForFree: true,
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
		author: { '@type': 'Person', name: 'Fajar Hidayat', url: 'https://github.com/fajarhide' },
		featureList: [
			'Distills noisy terminal output before it reaches the model',
			'Archives everything it removes to a local SQLite store, retrievable by hash',
			'Passes failing commands and structured data through untouched',
			'Carries project memory across sessions and across editors',
			'Runs as an MCP server and a shell hook',
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faq.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: { '@type': 'Answer', text: f.a },
		})),
	},
];

const pipeline = [
	{ k: 'Read', v: 'A shell hook catches stdout on its way to the agent. Nothing about how you work changes.' },
	{ k: 'Guard', v: 'Non-zero exit, or JSON, YAML, NDJSON, CSV? Straight through. <strong>This branch is taken more often than not.</strong>', quiet: true },
	{ k: 'Score', v: 'Every line gets a weight. Stack frames and errors score high, progress bars and passing tests score low.' },
	{ k: 'Collapse', v: 'Repetition folds. Four hundred passing tests become the runner\'s own summary line, never a paraphrase of it.' },
	{ k: 'Distill', v: 'A command-specific reader runs. Returning the input is always allowed, inventing a summary is not.' },
	{ k: 'Persist', v: 'Everything cut is hashed into local SQLite, so any of it comes back on demand.' },
];
---

<Layout
	title="OMNI, cut AI agent token costs by filtering terminal noise"
	description={`OMNI is a free Rust CLI that cuts terminal noise before your AI coding agent reads it, ${stats.overallSaved} fewer bytes across ${stats.totalCalls} real commands, and remembers your project between sessions. Always reversible, never invents a result. Works with Claude Code, Cursor and Windsurf.`}
	jsonLd={jsonLd}
>
	<main>
		<!-- HERO -->
		<section class="hero">
			<div class="wrap">
				<div class="hero-grid">
					<div>
						<h1 class="t-display">Claude is not expensive.<br />Your terminal is.</h1>

						<p class="lede">
							OMNI sits on a shell hook and takes the noise out of command output before your agent reads it. It also remembers your project between sessions, so you stop re-explaining it. Lossy, always reversible, and it never invents a result.
						</p>

						<div class="hero-actions">
							<a href={GITHUB_REPO} class="btn btn-solid" target="_blank" rel="noopener noreferrer">
								<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
								Read the source
							</a>
							<a href="#numbers" class="btn btn-ghost">See the numbers</a>
						</div>

						<div class="install">
							<div class="install-row">
								<span class="sigil" aria-hidden="true">$</span>
								<code>brew install fajarhide/tap/omni</code>
								<button class="copy" data-copy="brew install fajarhide/tap/omni" aria-label="Copy the install command">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
								</button>
							</div>
							<p class="install-alt">
								<span>Then <code>omni init</code>. Also on</span>
								<button class="linkish" data-copy="curl -fsSL omni.weekndlabs.com/install | bash">curl</button>
								<span>and</span>
								<button class="linkish" data-copy="irm omni.weekndlabs.com/install.ps1 | iex">PowerShell</button>
							</p>
						</div>
					</div>

					<!-- SIGNATURE: the subtraction happens in front of you.
					     The release badge sits here rather than above the headline,
					     so nothing stands between the reader and the first line. -->
					<div>
						<p class="release">
							<span class="release-dot" aria-hidden="true"></span>
							<span id="omni-version">{latestVersion}</span>
							<span aria-hidden="true">/</span>
							<span id="omni-status" data-status={versionLabel.toLowerCase().replace(' ', '-')}>{versionLabel}</span>
						</p>

						<figure class="crt" id="demo">
							<figcaption class="crt-bar">
								<span class="crt-case">
								<span id="reel-label">{demos[0].label}</span>
								<span class="crt-ctx" id="reel-ctx">{demos[0].context}</span>
							</span>
								<span class="crt-read">
									<span class="crt-phase" id="phase">raw</span>
									<span class="crt-meter" id="meter">{demos[0].fixture.input}</span>
								</span>
							</figcaption>
							<div class="crt-body" style={`--rows:${tallestReel}`}>
								{demos.map((d, di) => (
									<div class="reel" data-reel={di} hidden={di !== 0}>
										{d.lines.map((line) => (
											<div class={`ln${line.n ? ' ln-noise' : ''}`} style={line.i === null ? undefined : `--i:${line.i}`}>
												<span class="mark" aria-hidden="true">{line.n ? '−' : ' '}</span>
												<span class={`txt${line.keep ? ' keep' : ''}${line.prompt ? ' prompt' : ''}`}>{line.t}</span>
											</div>
										))}
									</div>
								))}
							</div>
							<div class="crt-foot">
								<span id="reel-saved">{demos[0].fixture.savings} smaller</span>
								<span>nothing deleted, all of it hashed to disk</span>
							</div>
						</figure>
						<p class="crt-cap">
							Reproducible on <code>tests/fixtures/</code>: <span id="reel-cap">{demos[0].cap}</span>
						</p>

						<!-- What the strike is actually doing, in the same row primitive
						     the rest of the page uses. Changes with the reel. -->
						<dl class="rows rows-tight">
							<div class="row">
								<dt class="row-k"><span class="gutter" aria-hidden="true">−</span>Cut</dt>
								<dd class="row-v" id="reel-cut">{demos[0].cut}</dd>
							</div>
							<div class="row">
								<dt class="row-k"><span class="gutter" aria-hidden="true">=</span>Kept</dt>
								<dd class="row-v" id="reel-kept">{demos[0].kept}</dd>
							</div>
						</dl>
					</div>
				</div>
			</div>
		</section>

		<!-- LIMITS AND PROMISES, one ledger -->
		<section class="band band-sunk" id="limits">
			<div class="wrap">
				<header class="band-head">
					<span class="eyebrow">Read this before installing</span>
					<h2 class="t-section">Where it fails, then what it promises</h2>
					<p class="lede">
						A tool that asks to sit between you and your output should lead with the parts that go badly.
					</p>
				</header>

				<dl class="rows">
					{limits.map((r) => (
						<div class="row row-quiet">
							<dt class="row-k is-mono">{r.k}<span class="sub">{r.sub}</span></dt>
							<dd class="row-v" set:html={r.v} />
						</div>
					))}
					{promises.map((r) => (
						<div class="row">
							<dt class="row-k">{r.k}</dt>
							<dd class="row-v">
								{r.v}
								{' '}
								<span class="receipt">
									<a href={r.proof.href} target="_blank" rel="noopener noreferrer">{r.proof.label}</a>
								</span>
							</dd>
						</div>
					))}
				</dl>

				<p class="fine" style="margin-top:18px;max-width:660px">
					Any tool claiming to save 90% of every command is telling you it summarised output you needed.
				</p>
			</div>
		</section>

		<!-- NUMBERS -->
		<section class="band" id="numbers">
			<div class="wrap">
				<header class="band-head">
					<span class="eyebrow">Benchmarks</span>
					<h2 class="t-section">{stats.totalCalls} real commands, replayed on the release binary</h2>
					<p class="lede">
						One developer's actual usage over months, not a fixture set chosen to flatter the result. {stats.bytesIn} in, {stats.bytesOut} out.
					</p>
				</header>

				<div class="ledger-wrap">
					<table class="ledger">
						<caption>Read from the README on main at build time, so the two cannot drift apart.</caption>
						<thead>
							<tr>
								<th scope="col">Command</th>
								<th scope="col">Calls</th>
								<th scope="col">In</th>
								<th scope="col">Out</th>
								<th scope="col">Saved</th>
							</tr>
						</thead>
						<tbody>
							{stats.rows.map((row) => (
								<tr>
									<th scope="row"><code>{row.command}</code></th>
									<td class="n">{row.calls}</td>
									<td class="n">{row.input}</td>
									<td class="n">{row.output}</td>
									<td class="saved"><span class="bar" style={`--w:${row.pct}%`}><span>{row.savings}</span></span></td>
								</tr>
							))}
						</tbody>
					</table>
				</div>

				<div class="stats">
					<div class="stat">
						<span class="stat-n">{stats.overallSaved}</span>
						<span class="stat-l">fewer bytes across the whole mix</span>
					</div>
					<div class="stat">
						<span class="stat-n">{best.savings}</span>
						<span class="stat-l">best case, <code>{best.command}</code> over {best.calls} calls</span>
					</div>
					<div class="stat">
						<span class="stat-n">{worst.savings}</span>
						<span class="stat-l">worst case, <code>{worst.command}</code> over {worst.calls} calls</span>
					</div>
				</div>

				<p class="fine" style="margin-top:20px;max-width:660px">
					<code>{best.command}</code> carries the result and <code>{worst.command}</code> is close to a no-op. The weak row stays in the table, because quietly dropping the rows that look bad is how {stats.overallSaved} turns into a fake 90%. Run <code>omni stats</code> for your own.
				</p>
			</div>
		</section>

		<!-- MEMORY -->
		<section class="band band-sunk" id="memory">
			<div class="wrap">
				<header class="band-head">
					<span class="eyebrow">The other half</span>
					<h2 class="t-section">Your agent also forgets everything overnight</h2>
				</header>

				<dl class="rows">
					{memory.map((m) => (
						<div class="row">
							<dt class="row-k">{m.k}</dt>
							<dd class="row-v">
								<span class="was">{m.was}</span>
								<span class="now">{m.now}</span>
							</dd>
						</div>
					))}
				</dl>
			</div>
		</section>

		<!-- COMMANDS -->
		<section class="band" id="cli">
			<div class="wrap">
				<header class="band-head">
					<span class="eyebrow">The CLI</span>
					<h2 class="t-section">Nine commands, all of them local</h2>
					<p class="lede">
						No dashboard and no account. Nothing about your machine leaves it.
					</p>
				</header>

				<dl class="rows">
					{commands.map((c) => (
						<div class="row">
							<dt class="row-k is-mono">{c.k}</dt>
							<dd class="row-v" set:html={c.v} />
						</div>
					))}
				</dl>
			</div>
		</section>

		<!-- PIPELINE -->
		<section class="band band-sunk" id="how">
			<div class="wrap">
				<header class="band-head">
					<span class="eyebrow">How it works</span>
					<h2 class="t-section">Six stages, and the second one usually ends it</h2>
				</header>

				<dl class="rows">
					{pipeline.map((s) => (
						<div class={`row${s.quiet ? ' row-quiet' : ''}`}>
							<dt class="row-k">{s.k}</dt>
							<dd class="row-v" set:html={s.v} />
						</div>
					))}
				</dl>

				<p class="fine" style="margin-top:18px;max-width:660px">
					If OMNI panics it fails open: the raw output passes through and your agent never notices. That is the design, not a safety net bolted on afterwards.
				</p>
			</div>
		</section>

		<!-- FAQ -->
		<section class="band" id="faq">
			<div class="wrap">
				<header class="band-head">
					<span class="eyebrow">Questions</span>
					<h2 class="t-section">What people ask before installing it</h2>
				</header>

				<dl class="rows">
					{faq.map((f) => (
						<div class="row">
							<dt class="row-k">{f.q}</dt>
							<dd class="row-v">{f.a}</dd>
						</div>
					))}
				</dl>
			</div>
		</section>

		<!-- CLOSE -->
		<section class="band band-sunk" id="start">
			<div class="wrap wrap-text">
				<h2 class="t-section">A passion project, MIT licensed</h2>
				<p class="lede" style="margin:14px 0 24px">
					Built by one developer who got tired of paying to read progress bars. If it saves you nothing, <code>omni stats</code> will say so and <code>omni reset</code> removes it. That is the whole deal.
				</p>
				<div class="hero-actions" style="margin-bottom:0">
					<a href={GITHUB_REPO} class="btn btn-solid" target="_blank" rel="noopener noreferrer">
						<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
						Read the source
					</a>
					<a href={GITHUB_RELEASES} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">Releases</a>
				</div>
			</div>
		</section>
	</main>

	<script define:vars={{ reels: demos.map((d) => ({ ...d.fixture, label: d.label, context: d.context, cap: d.cap, cut: d.cut, kept: d.kept, noise: d.lines.filter((l) => l.n).length })) }}>
		// The signature: the subtraction runs on a slow loop while the block is on
		// screen, so a reader who arrives mid-cycle still sees it happen. Three
		// commands take turns, because one 93% demo would misrepresent the tool.
		const demo = document.getElementById('demo');
		const el = (id) => document.getElementById(id);
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		function setPhase(label, on) {
			const phase = el('phase');
			phase.textContent = label;
			if (on) phase.setAttribute('data-on', '');
			else phase.removeAttribute('data-on');
		}

		function show(i) {
			demo.querySelectorAll('.reel').forEach((r) => {
				r.hidden = Number(r.dataset.reel) !== i;
			});
			el('reel-label').textContent = reels[i].label;
			el('reel-ctx').textContent = reels[i].context;
			el('reel-saved').textContent = reels[i].savings + ' smaller';
			el('reel-cap').textContent = reels[i].cap;
			el('reel-cut').textContent = reels[i].cut;
			el('reel-kept').textContent = reels[i].kept;
			el('meter').textContent = reels[i].input;
		}

		if (demo && reduced) {
			// No loop and no cycling. One command, shown already distilled.
			demo.classList.add('scoring', 'cut');
			setPhase('distilled', true);
			el('meter').textContent = reels[0].output;
		} else if (demo) {
			let onScreen = false;
			new IntersectionObserver(
				(entries) => entries.forEach((e) => { onScreen = e.isIntersecting; }),
				{ threshold: 0.25 }
			).observe(demo);

			const wait = (ms) => new Promise((r) => setTimeout(r, ms));

			(async () => {
				for (let i = 0; ; i = (i + 1) % reels.length) {
					while (!onScreen) await wait(400);
					show(i);
					setPhase('raw', false);
					await wait(1600);                        // the output as the shell wrote it
					demo.classList.add('scoring');
					setPhase('scoring', true);
					await wait(reels[i].noise * 110 + 400);  // the strike walks every noise line
					demo.classList.add('cut');
					setPhase('distilled', true);
					el('meter').textContent = reels[i].output;
					await wait(4200);                        // hold on what survived
					demo.classList.remove('scoring', 'cut');
					await wait(700);                         // let the lines come back up
				}
			})();
		}

		// Copy buttons.
		document.querySelectorAll('[data-copy]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const text = btn.getAttribute('data-copy');
				if (!text) return;
				navigator.clipboard.writeText(text);
				const original = btn.innerHTML;
				btn.innerHTML = btn.classList.contains('copy')
					? '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>'
					: 'Copied';
				setTimeout(() => { btn.innerHTML = original; }, 1800);
			});
		});

		// Keep the release badge current between deploys.
		fetch('https://api.github.com/repos/fajarhide/omni/releases/latest')
			.then((r) => (r.ok ? r.json() : null))
			.then((data) => {
				if (!data) return;
				const v = document.getElementById('omni-version');
				const s = document.getElementById('omni-status');
				if (v && data.tag_name !== v.textContent) {
					v.textContent = data.tag_name;
					const tag = data.tag_name;
					const label = tag.includes('-rc') ? 'Release candidate'
						: tag.includes('-alpha') ? 'Alpha'
						: tag.includes('-beta') ? 'Beta'
						: 'Stable';
					if (s) {
						s.textContent = label;
						s.setAttribute('data-status', label.toLowerCase().replace(' ', '-'));
					}
				}
			})
			.catch(() => {});
	</script>
</Layout>
