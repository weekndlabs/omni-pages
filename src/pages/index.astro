---
import Layout from '../layouts/Layout.astro';
import { getBenchmarkStats, extremes } from '../lib/readme-stats.js';

const GITHUB_REPO = 'https://github.com/fajarhide/omni';
const GITHUB_RELEASES = `${GITHUB_REPO}/releases`;

const getVersionLabel = (version) => {
	if (version.includes('-rc')) return 'Release candidate';
	if (version.includes('-alpha')) return 'Alpha';
	if (version.includes('-beta')) return 'Beta';
	return 'Stable';
};

let latestVersion = 'v0.6.0';
let versionLabel = getVersionLabel(latestVersion);

try {
	const response = await fetch('https://api.github.com/repos/fajarhide/omni/releases/latest');
	if (response.ok) {
		const data = await response.json();
		latestVersion = data.tag_name;
		versionLabel = getVersionLabel(latestVersion);
	}
} catch (e) {
	console.error('Failed to fetch latest OMNI version:', e);
}

// Benchmark figures are read from the OMNI README on `main` at build time.
// Do not hardcode them here. See src/lib/readme-stats.js.
const stats = await getBenchmarkStats();
const { best, worst } = extremes(stats.rows);
const workingShare = (100 - parseFloat(stats.zeroSaveShare)).toFixed(1) + '%';

/* Hero demo. Real `cargo test` shape, with the lines OMNI drops marked so the
   block can subtract them in place. `n` is the noise flag. */
const demo = [
	{ t: '$ cargo test', prompt: true },
	{ t: '   Compiling omni v0.6.0 (/Users/f/omni)', n: true },
	{ t: '   Compiling serde v1.0.210', n: true },
	{ t: '   Compiling regex v1.10.6', n: true },
	{ t: '    Finished test profile in 41.20s', n: true },
	{ t: '     Running unittests src/lib.rs', n: true },
	{ t: 'test pipeline::score::keeps_stack_frames ... ok', n: true },
	{ t: 'test pipeline::score::drops_progress_bars ... ok', n: true },
	{ t: 'test pipeline::format::json_passthrough ... ok', n: true },
	{ t: 'test rewind::store::roundtrip_sha256 ... ok', n: true },
	{ t: 'test rewind::store::retrieve_by_hash ... ok', n: true },
	{ t: '... 478 more passing tests ...', n: true },
	{ t: 'test distill::cargo::parses_summary ... FAILED', keep: true },
	{ t: '' },
	{ t: 'failures:' },
	{ t: '    thread panicked at src/distill/cargo.rs:118:9', keep: true },
	{ t: '    assertion `left == right` failed' },
	{ t: '      left: 490' },
	{ t: '     right: 500' },
	{ t: '' },
	{ t: 'test result: FAILED. 490 passed; 10 failed', keep: true },
];

/* Limits first, then promises. Same row shape, so they read as one ledger. */
const limits = [
	{
		k: stats.zeroSaveShare,
		sub: 'of all calls',
		v: `saved nothing at all. Across ${stats.totalCalls} replayed executions close to two thirds went straight back, zero bytes added, zero removed. All of the ${stats.overallSaved} headline comes from the other ${workingShare}.`,
	},
	{
		k: '82 to 308 ms',
		sub: 'per hooked command',
		v: 'and the cost grows with your history. A 496 byte <code>git status</code> takes about 82ms against a fresh database and about 308ms against a 97 MB one. A 16.5 KB <code>cargo test</code> takes about 276ms. Budget for it.',
	},
	{
		k: 'exit != 0',
		sub: 'never compressed',
		v: 'Failing commands pass through whole, structured output is never touched, and a distiller that cannot parse its input stays quiet instead of guessing.',
	},
];

const promises = [
	{
		k: 'Reversible',
		v: 'Everything cut is archived to local SQLite keyed by SHA-256. Your agent gets the hash and calls it back when it wants the rest.',
		proof: { label: 'omni rewind', href: `${GITHUB_REPO}#how-it-works` },
	},
	{
		k: 'Never invents',
		v: 'A distiller that parsed no signal hands back the raw output. It will not write a green "no errors" line that nothing supports.',
		proof: { label: 'issue 143', href: `${GITHUB_REPO}/issues/143` },
	},
	{
		k: 'Never hides',
		v: 'Any command that exits non-zero passes through untouched. A buried error costs more than an uncompressed one.',
		proof: { label: 'issue 120', href: `${GITHUB_REPO}/issues/120` },
	},
	{
		k: 'Never mangles',
		v: 'JSON, YAML, NDJSON and CSV go through byte for byte, because a corrupted payload costs more than a missed compression.',
		proof: { label: 'pipeline::format', href: `${GITHUB_REPO}/tree/main/src/pipeline` },
	},
];

const memory = [
	{
		k: 'New session',
		was: 'You re-explain the project layout, which module is broken, and that it is Postgres rather than MySQL.',
		now: 'The agent already has it. You carry on from where you stopped.',
	},
	{
		k: 'Bug you already fixed',
		was: 'The agent walks into the same framework quirk it solved yesterday, because nothing kept the answer.',
		now: 'omni recall returns the stored fix in under 10ms.',
	},
	{
		k: 'Cursor to Claude Code',
		was: 'New editor, new agent, no context. You start over.',
		now: 'The session summary is injected on the way in. The new agent is current.',
	},
	{
		k: 'Agent drifts off task',
		was: 'Three prompts later it is refactoring something you never asked about.',
		now: 'omni goal restates the objective on every prompt.',
	},
];

/* Verified against docs/HOW_TO_USE.md in the omni repo. */
const commands = [
	{ k: 'omni init', v: 'Wire the hook into Claude Code, Cursor, Windsurf, Codex or Antigravity. Interactive.' },
	{ k: 'omni doctor --fix', v: 'Check hooks, MCP wiring and filter cost, then repair whatever is broken.' },
	{ k: 'omni stats', v: 'What it actually saved on your machine. Takes <code>--today</code>, <code>--week</code>, <code>--month</code>.' },
	{ k: 'omni session --status', v: 'Context pressure, stored engrams, and the errors still open in this session.' },
	{ k: 'omni rewind list', v: 'Every chunk it archived. Pass a hash to read that one back in full.' },
	{ k: 'omni learn --discover', v: 'Read your shell history and propose filters for your own internal tools.' },
	{ k: 'omni trust', v: 'Review and approve the filters a project ships in <code>.omni/signals/</code>.' },
	{ k: 'omni init --uninstall', v: 'Take it back out. One command, no residue.' },
];

const pipeline = [
	{ k: 'Read', v: 'A shell hook catches stdout on its way to the agent. Nothing about how you work changes.' },
	{ k: 'Guard', v: 'Non-zero exit, or JSON, YAML, NDJSON, CSV? Straight through. <strong>This branch is taken more often than not.</strong>', quiet: true },
	{ k: 'Score', v: 'Every line gets a weight. Stack frames and errors score high, progress bars and passing tests score low.' },
	{ k: 'Collapse', v: 'Repetition folds. Four hundred passing tests become the runner\'s own summary line, never a paraphrase of it.' },
	{ k: 'Distill', v: 'A command-specific reader runs. Returning the input is always allowed, inventing a summary is not.' },
	{ k: 'Persist', v: 'Everything cut is hashed into local SQLite, so any of it comes back on demand.' },
];
---

<Layout
	title="OMNI, noise-canceling context and memory for your AI agent"
	description={`OMNI cuts terminal noise before your AI agent reads it, ${stats.overallSaved} fewer bytes across ${stats.totalCalls} real commands, and remembers your project between sessions. Lossy, always reversible, never invents a result. Rust, MIT, local only.`}
>
	<main>
		<!-- HERO -->
		<section class="hero">
			<div class="wrap">
				<div class="hero-grid">
					<div>
						<h1 class="t-display">Claude is not expensive.<br />Your terminal is.</h1>

						<p class="lede">
							OMNI sits on a shell hook and takes the noise out of command output before your agent reads it. It also remembers your project between sessions, so you stop re-explaining it. Lossy, always reversible, and it never invents a result.
						</p>

						<div class="hero-actions">
							<a href={GITHUB_REPO} class="btn btn-solid" target="_blank" rel="noopener noreferrer">
								<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
								Read the source
							</a>
							<a href="#numbers" class="btn btn-ghost">See the numbers</a>
						</div>

						<div class="install">
							<div class="install-row">
								<span class="sigil" aria-hidden="true">$</span>
								<code>brew install fajarhide/tap/omni</code>
								<button class="copy" data-copy="brew install fajarhide/tap/omni" aria-label="Copy the install command">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
								</button>
							</div>
							<p class="install-alt">
								<span>Then <code>omni init</code>. Also on</span>
								<button class="linkish" data-copy="curl -fsSL omni.weekndlabs.com/install | bash">curl</button>
								<span>and</span>
								<button class="linkish" data-copy="irm omni.weekndlabs.com/install.ps1 | iex">PowerShell</button>
							</p>
						</div>
					</div>

					<!-- SIGNATURE: the subtraction happens in front of you.
					     The release badge sits here rather than above the headline,
					     so nothing stands between the reader and the first line. -->
					<div>
						<p class="release">
							<span class="release-dot" aria-hidden="true"></span>
							<span id="omni-version">{latestVersion}</span>
							<span aria-hidden="true">/</span>
							<span id="omni-status" data-status={versionLabel.toLowerCase().replace(' ', '-')}>{versionLabel}</span>
						</p>

						<figure class="crt" id="demo">
							<figcaption class="crt-bar">
								<span>tests/fixtures / cargo test</span>
								<span class="crt-meter" id="meter">{stats.fixture.input}</span>
							</figcaption>
							<div class="crt-body">
								{demo.map((line) => (
									<div class={`ln${line.n ? ' ln-noise' : ''}`}>
										<span class="mark" aria-hidden="true">{line.n ? '−' : ' '}</span>
										<span class={`txt${line.keep ? ' keep' : ''}${line.prompt ? ' prompt' : ''}`}>{line.t}</span>
									</div>
								))}
							</div>
							<div class="crt-foot">
								<span>{stats.fixture.savings} smaller</span>
								<span>nothing deleted, all of it hashed to disk</span>
							</div>
						</figure>
						<p class="crt-cap">
							Reproducible on <code>tests/fixtures/</code>: {stats.fixture.input} of output becomes {stats.fixture.output}. The verdict survives, the 478 passing tests never reach the model.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- LIMITS AND PROMISES, one ledger -->
		<section class="band band-sunk" id="limits">
			<div class="wrap">
				<header class="band-head">
					<span class="eyebrow">Read this before installing</span>
					<h2 class="t-section">Where it fails, then what it promises</h2>
					<p class="lede">
						A tool that asks to sit between you and your output should lead with the parts that go badly.
					</p>
				</header>

				<dl class="rows">
					{limits.map((r) => (
						<div class="row row-quiet">
							<dt class="row-k is-mono">{r.k}<span class="sub">{r.sub}</span></dt>
							<dd class="row-v" set:html={r.v} />
						</div>
					))}
					{promises.map((r) => (
						<div class="row">
							<dt class="row-k">{r.k}</dt>
							<dd class="row-v">
								{r.v}
								{' '}
								<span class="receipt">
									<a href={r.proof.href} target="_blank" rel="noopener noreferrer">{r.proof.label}</a>
								</span>
							</dd>
						</div>
					))}
				</dl>

				<p class="fine" style="margin-top:18px;max-width:660px">
					Any tool claiming to save 90% of every command is telling you it summarised output you needed.
				</p>
			</div>
		</section>

		<!-- NUMBERS -->
		<section class="band" id="numbers">
			<div class="wrap">
				<header class="band-head">
					<span class="eyebrow">Benchmarks</span>
					<h2 class="t-section">{stats.totalCalls} real commands, replayed on the release binary</h2>
					<p class="lede">
						One developer's actual usage over months, not a fixture set chosen to flatter the result. {stats.bytesIn} in, {stats.bytesOut} out.
					</p>
				</header>

				<div class="ledger-wrap">
					<table class="ledger">
						<caption>Read from the README on main at build time, so the two cannot drift apart.</caption>
						<thead>
							<tr>
								<th scope="col">Command</th>
								<th scope="col">Calls</th>
								<th scope="col">In</th>
								<th scope="col">Out</th>
								<th scope="col">Saved</th>
							</tr>
						</thead>
						<tbody>
							{stats.rows.map((row) => (
								<tr>
									<th scope="row"><code>{row.command}</code></th>
									<td class="n">{row.calls}</td>
									<td class="n">{row.input}</td>
									<td class="n">{row.output}</td>
									<td class="saved"><span class="bar" style={`--w:${row.pct}%`}><span>{row.savings}</span></span></td>
								</tr>
							))}
						</tbody>
					</table>
				</div>

				<div class="stats">
					<div class="stat">
						<span class="stat-n">{stats.overallSaved}</span>
						<span class="stat-l">fewer bytes across the whole mix</span>
					</div>
					<div class="stat">
						<span class="stat-n">{best.savings}</span>
						<span class="stat-l">best case, <code>{best.command}</code> over {best.calls} calls</span>
					</div>
					<div class="stat">
						<span class="stat-n">{worst.savings}</span>
						<span class="stat-l">worst case, <code>{worst.command}</code> over {worst.calls} calls</span>
					</div>
				</div>

				<p class="fine" style="margin-top:20px;max-width:660px">
					<code>{best.command}</code> carries the result and <code>{worst.command}</code> is close to a no-op. The weak row stays in the table, because quietly dropping the rows that look bad is how {stats.overallSaved} turns into a fake 90%. Run <code>omni stats</code> for your own.
				</p>
			</div>
		</section>

		<!-- MEMORY -->
		<section class="band band-sunk" id="memory">
			<div class="wrap">
				<header class="band-head">
					<span class="eyebrow">The other half</span>
					<h2 class="t-section">Your agent also forgets everything overnight</h2>
				</header>

				<dl class="rows">
					{memory.map((m) => (
						<div class="row">
							<dt class="row-k">{m.k}</dt>
							<dd class="row-v">
								<span class="was">{m.was}</span>
								<span class="now">{m.now}</span>
							</dd>
						</div>
					))}
				</dl>
			</div>
		</section>

		<!-- COMMANDS -->
		<section class="band" id="cli">
			<div class="wrap">
				<header class="band-head">
					<span class="eyebrow">The CLI</span>
					<h2 class="t-section">Eight commands, all of them local</h2>
					<p class="lede">
						No dashboard and no account. Nothing about your machine leaves it.
					</p>
				</header>

				<dl class="rows">
					{commands.map((c) => (
						<div class="row">
							<dt class="row-k is-mono">{c.k}</dt>
							<dd class="row-v" set:html={c.v} />
						</div>
					))}
				</dl>
			</div>
		</section>

		<!-- PIPELINE -->
		<section class="band band-sunk" id="how">
			<div class="wrap">
				<header class="band-head">
					<span class="eyebrow">How it works</span>
					<h2 class="t-section">Six stages, and the second one usually ends it</h2>
				</header>

				<dl class="rows">
					{pipeline.map((s) => (
						<div class={`row${s.quiet ? ' row-quiet' : ''}`}>
							<dt class="row-k">{s.k}</dt>
							<dd class="row-v" set:html={s.v} />
						</div>
					))}
				</dl>

				<p class="fine" style="margin-top:18px;max-width:660px">
					If OMNI panics it fails open: the raw output passes through and your agent never notices. That is the design, not a safety net bolted on afterwards.
				</p>
			</div>
		</section>

		<!-- CLOSE -->
		<section class="band" id="start">
			<div class="wrap wrap-text">
				<h2 class="t-section">A passion project, MIT licensed</h2>
				<p class="lede" style="margin:14px 0 24px">
					Built by one developer who got tired of paying to read progress bars. If it saves you nothing, <code>omni stats</code> will say so and <code>omni init --uninstall</code> removes it. That is the whole deal.
				</p>
				<div class="hero-actions" style="margin-bottom:0">
					<a href={GITHUB_REPO} class="btn btn-solid" target="_blank" rel="noopener noreferrer">
						<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
						Read the source
					</a>
					<a href={GITHUB_RELEASES} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">Releases</a>
				</div>
			</div>
		</section>
	</main>

	<script define:vars={{ fixtureOut: stats.fixture.output }}>
		// The signature: run the subtraction once, when the block is on screen.
		const demo = document.getElementById('demo');
		const meter = document.getElementById('meter');
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		function subtract() {
			demo.classList.add('cut');
			if (meter) meter.textContent = fixtureOut;
		}

		if (demo) {
			if (reduced) {
				subtract();
			} else {
				const io = new IntersectionObserver(
					(entries) => {
						entries.forEach((e) => {
							if (!e.isIntersecting) return;
							io.disconnect();
							setTimeout(subtract, 900);
						});
					},
					{ threshold: 0.35 }
				);
				io.observe(demo);
			}
		}

		// Copy buttons.
		document.querySelectorAll('[data-copy]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const text = btn.getAttribute('data-copy');
				if (!text) return;
				navigator.clipboard.writeText(text);
				const original = btn.innerHTML;
				btn.innerHTML = btn.classList.contains('copy')
					? '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>'
					: 'Copied';
				setTimeout(() => { btn.innerHTML = original; }, 1800);
			});
		});

		// Keep the release badge current between deploys.
		fetch('https://api.github.com/repos/fajarhide/omni/releases/latest')
			.then((r) => (r.ok ? r.json() : null))
			.then((data) => {
				if (!data) return;
				const v = document.getElementById('omni-version');
				const s = document.getElementById('omni-status');
				if (v && data.tag_name !== v.textContent) {
					v.textContent = data.tag_name;
					const tag = data.tag_name;
					const label = tag.includes('-rc') ? 'Release candidate'
						: tag.includes('-alpha') ? 'Alpha'
						: tag.includes('-beta') ? 'Beta'
						: 'Stable';
					if (s) {
						s.textContent = label;
						s.setAttribute('data-status', label.toLowerCase().replace(' ', '-'));
					}
				}
			})
			.catch(() => {});
	</script>
</Layout>
