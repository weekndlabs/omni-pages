---
import Layout from '../layouts/Layout.astro';
import { getBenchmarkStats, extremes } from '../lib/readme-stats.js';

const GITHUB_REPO = 'https://github.com/fajarhide/omni';
const GITHUB_RELEASES = `${GITHUB_REPO}/releases`;

const getVersionLabel = (version) => {
	if (version.includes('-rc')) return 'Release candidate';
	if (version.includes('-alpha')) return 'Alpha';
	if (version.includes('-beta')) return 'Beta';
	return 'Stable';
};

let latestVersion = 'v0.6.9';
let versionLabel = getVersionLabel(latestVersion);

try {
	const response = await fetch('https://api.github.com/repos/fajarhide/omni/releases/latest');
	if (response.ok) {
		const data = await response.json();
		latestVersion = data.tag_name;
		versionLabel = getVersionLabel(latestVersion);
	}
} catch (e) {
	console.error('Failed to fetch latest OMNI version:', e);
}

// Benchmark figures are read from the OMNI README on `main` at build time.
// Do not hardcode them here. See src/lib/readme-stats.js.
const stats = await getBenchmarkStats();
const { best, worst } = extremes(stats.rows);
const fileRead = stats.rows.find((r) => /file read/i.test(r.command));
const workingShare = (100 - parseFloat(stats.zeroSaveShare)).toFixed(1) + '%';
/* Derived, not written down. The copy said "about 1 command in 10" while the
   parsed share was 2.7%, which is 1 in 37. A page selling published honesty
   cannot carry a number that is four times out. */
const oneIn = Math.round(100 / (100 - parseFloat(stats.zeroSaveShare)));

/* Hero demo. Three real command shapes, with the lines OMNI drops marked so the
   block can subtract them in place. `n` is the noise flag, `keep` highlights the
   part that survives. Every byte figure comes from the README fixture table, and
   the three are chosen to span the range on purpose: a command that pays for
   itself, an ordinary one, and one that barely does. A page arguing against fake
   90% claims cannot show three 90% demos.

   Every path and module below exists in the omni repository on `main`. They were
   invented once (`src/rewind/`, `src/distill/`, `pipeline/score.rs`) and that is
   fabricated output in the first screen of a tool whose pitch is that it never
   fabricates output. Check against `git ls-tree` before editing one. */
const cargoTest = [
	{ t: '$ cargo test', prompt: true },
	{ t: `   Compiling omni ${latestVersion} (/Users/f/omni)`, n: true },
	{ t: '   Compiling serde v1.0.210', n: true },
	{ t: '   Compiling regex v1.10.6', n: true },
	{ t: '    Finished test profile in 41.20s', n: true },
	{ t: '     Running unittests src/lib.rs', n: true },
	{ t: 'test pipeline::scorer::keeps_stack_frames ... ok', n: true },
	{ t: 'test pipeline::scorer::drops_progress_bars ... ok', n: true },
	{ t: 'test pipeline::format::json_passthrough ... ok', n: true },
	{ t: 'test ledger::folds_a_run_already_shown ... ok', n: true },
	{ t: 'test store::sqlite::roundtrip_sha256 ... ok', n: true },
	{ t: '... 478 more passing tests ...', n: true },
	{ t: 'test distillers::test::parses_summary ... FAILED', keep: true },
	{ t: '', n: true },
	{ t: 'failures:' },
	{ t: '    thread panicked at src/distillers/test.rs:118:9', keep: true },
	{ t: '    assertion `left == right` failed' },
	{ t: '      left: 490' },
	{ t: '     right: 500' },
	{ t: '', n: true },
	{ t: 'test result: FAILED. 490 passed; 10 failed', keep: true },
];

/* The six hint lines git prints every single time, gone. What changed, stays. */
const gitStatus = [
	{ t: '$ git status', prompt: true },
	{ t: 'On branch main' },
	{ t: "Your branch is ahead of 'origin/main' by 2 commits." },
	{ t: '  (use "git push" to publish your local commits)', n: true },
	{ t: '', n: true },
	{ t: 'Changes not staged for commit:' },
	{ t: '  (use "git add <file>..." to update what will be committed)', n: true },
	{ t: '  (use "git restore <file>..." to discard changes)', n: true },
	{ t: '        modified:   src/pipeline/scorer.rs', keep: true },
	{ t: '        modified:   src/distillers/test.rs', keep: true },
	{ t: '', n: true },
	{ t: 'Untracked files:' },
	{ t: '  (use "git add <file>..." to include in what will be committed)', n: true },
	{ t: '        tests/fixtures/docker-build.txt', keep: true },
	{ t: '', n: true },
	{ t: 'no changes added to commit (use "git add" to track them)', n: true },
];

/* The honest one. A successful build is mostly layer bookkeeping, but the
   bookkeeping is only a third of the bytes, so a third is all it saves. */
const dockerBuild = [
	{ t: '$ docker build -t omni:ci .', prompt: true },
	{ t: '#1 [internal] load build definition from Dockerfile' },
	{ t: '#1 transferring dockerfile: 412B done', n: true },
	{ t: '#1 DONE 0.0s', n: true },
	{ t: '#2 [internal] load .dockerignore' },
	{ t: '#2 transferring context: 108B done', n: true },
	{ t: '#2 DONE 0.0s', n: true },
	{ t: '#3 [internal] load metadata for docker.io/library/rust:1.79' },
	{ t: '#3 DONE 1.2s', n: true },
	{ t: '#4 [builder 1/5] FROM docker.io/library/rust:1.79' },
	{ t: '#4 CACHED' },
	{ t: '#5 [internal] load build context' },
	{ t: '#5 transferring context: 2.14MB done', n: true },
	{ t: '#5 DONE 0.3s', n: true },
	{ t: '#8 [builder 4/5] RUN cargo build --release' },
	{ t: '#8 24.61 warning: unused import: `std::fmt`', keep: true },
	{ t: '#8 24.61   --> src/store/sqlite.rs:4:5', keep: true },
	{ t: '#8 DONE 61.4s', n: true },
	{ t: '#9 exporting to image' },
	{ t: '#9 writing image sha256:9f2c1a3e8b04', keep: true },
	{ t: '#9 naming to docker.io/library/omni:ci done', keep: true },
];

/* Noise lines get an ordinal so the strike can walk down the block one line at
   a time. That walk is the whole point: it shows the scoring pass happening. */
const reel = (lines) => {
	let n = 0;
	return lines.map((line) => ({ ...line, i: line.n ? n++ : null }));
};

const fx = stats.fixtures;

/* One entry per command in the reel. `cap` is the measurement, and it is the only
   prose the block gets: the strike itself shows what went and what stayed. */
const demos = [
	{
		fixture: fx['cargo test'],
		lines: reel(cargoTest),
		cap: `${fx['cargo test'].input} of test output becomes ${fx['cargo test'].output}, a ${fx['cargo test'].savings} cut.`,
	},
	{
		fixture: fx['git status'],
		lines: reel(gitStatus),
		cap: `${fx['git status'].input} becomes ${fx['git status'].output}, a ${fx['git status'].savings} cut on a command your agent runs constantly.`,
	},
	{
		fixture: fx['docker build'],
		lines: reel(dockerBuild),
		cap: `${fx['docker build'].input} becomes ${fx['docker build'].output}, a ${fx['docker build'].savings} cut on output that is mostly layer bookkeeping.`,
	},
];

/* The bar names the case with the context string straight out of the README
   fixture table ("490 passed, 10 failed", "dirty", "heavy noise"), so the label
   is a parsed measurement rather than one more claim to keep true. The position
   tells a reader who lands mid cycle that two more cases are coming. */
demos.forEach((d, i) => {
	// Split at the parenthetical so a narrow bar can drop the context rather than
	// truncate it mid word. "1 of 3 · cargo test" survives on its own.
	const [, cmd, ctx = ''] = d.fixture.command.match(/^([^(]+)(\(.*\))?$/);
	d.label = `${i + 1} of ${demos.length} · ${cmd.trim()}`;
	d.context = ctx;
});

/* The reel switches between blocks of different length, so the body is pinned to
   the tallest. Nothing on the page may move while it plays. */
const tallestReel = Math.max(...demos.map((d) => d.lines.length));

/* Limits first, then promises. Same row shape, so they read as one ledger. */
const limits = [
	{
		k: `1 in ${oneIn}`,
		sub: 'commands is touched at all',
		/* This used to end "all of the headline comes from that 2.7%, 181 calls
		   that each came back about 5.3 KB lighter". Both figures were the 0.7.4
		   manual's and neither survives its rewrite: the headline is now the
		   with-ledger number, and the ledger folds 882 calls where 236 shrank
		   under the filters, so the headline demonstrably does not all come from
		   the calls this row counts. Rather than derive a replacement from two
		   rows whose scopes the doc does not state, the claim is gone. What is
		   left is what benchmarks.md states outright. */
		v: `and the other ${stats.zeroSaveShare} are handed back with zero bytes added, because taking anything would be unsafe or would not pay for its own marker. That is why it is safe to leave on for everything: not one call in ${stats.totalCalls} came out larger. On the ones it does touch, file reads give up ${fileRead?.savings ?? '89.6%'}.`,
	},
	{
		k: '21 to 61 ms',
		sub: 'per hooked command',
		v: 'and the cost grows with your history rather than with the payload. A 496 byte <code>git status</code> takes about 21ms against a fresh database and about 61ms against a 205 MB one. A 16.5 KB <code>cargo test</code> takes 24ms and 65ms. Budget for it.',
	},
	{
		k: 'exit != 0',
		sub: 'never compressed',
		v: 'Failing commands pass through whole, structured output is never touched, and a distiller that cannot parse its input stays quiet instead of guessing.',
	},
];

const promises = [
	{
		k: 'Reversible',
		/* Both bounds are published because the unbounded version of this sentence
		   was false until v0.6.9: the archive gate never fired, and 0 of 8,968
		   distillations carried a hash. The receipt is the issue that found it.
		   The 30 day window is the manual's own limit on a handle, and it is the
		   one thing "nothing is ever lost" cannot promise. */
		v: 'Everything cut is archived to local SQLite keyed by SHA-256, for inputs up to 64 KB. The marker carries the handle and <code>omni retrieve</code> prints the original on any host. Above the cap nothing is archived and the marker says so, with the size. The archive is a rolling 30 day window, so a handle older than that will not resolve.',
		proof: { label: 'issue 271', href: `${GITHUB_REPO}/issues/271` },
	},
	{
		k: 'Never invents',
		v: 'A distiller that parsed no signal hands back the raw output. It will not write a green "no errors" line that nothing supports.',
		proof: { label: 'issue 143', href: `${GITHUB_REPO}/issues/143` },
	},
	{
		k: 'Never hides',
		v: 'Any command that exits non-zero passes through untouched. A buried error costs more than an uncompressed one.',
		proof: { label: 'issue 120', href: `${GITHUB_REPO}/issues/120` },
	},
	{
		k: 'Never mangles',
		v: 'JSON, YAML, NDJSON and CSV go through byte for byte, because a corrupted payload costs more than a missed compression.',
		proof: { label: 'pipeline::format', href: `${GITHUB_REPO}/tree/main/src/pipeline` },
	},
];

/* The ledger. It is where most of the saving now comes from, and the page had the
   evidence for it in the benchmark table while the pitch never mentioned it: file
   read is the largest class, the filters take 0.0% of it, and the ledger takes the
   rest. Numbers here are parsed except the 214 bytes, which is the README's own
   second-read fixture and lives in prose there rather than in the benchmark doc. */
const ledger = [
	{
		k: '214 B',
		sub: 'the second read',
		v: 'A file your agent reads twice costs full price, then this. The repeat comes back as one marker carrying a handle, because those bytes are already in its context, and <code>omni retrieve</code> hands the file back in full if it is ever needed.',
	},
	{
		k: stats.repeated,
		sub: 'of raw bytes',
		v: `were lines the agent had already been shown, and ${stats.repeatedAfterDistillers} still are after every distiller has run. Filtering barely dents repetition, because repetition is not noise. It is signal that was already delivered.`,
	},
	{
		k: fileRead?.savings ?? '89.6%',
		sub: 'off file reads',
		v: `the largest class in the corpus at ${fileRead?.calls ?? '884'} calls and ${fileRead?.input ?? '10.93 MB'}. The filters take ${fileRead?.filters ?? '39.2%'} of it and the ledger takes ${fileRead?.savings ?? '89.6%'}, because a second read is bytes the agent is already holding rather than lines anyone had to guess at.`,
	},
	{
		k: 'Across sessions',
		v: 'The store is one SQLite file keyed by project path rather than by agent, so a second agent in the same directory gets a handle for output an earlier session produced. That marker reads <code>from an earlier session</code> and not <code>already shown</code>, because this agent has genuinely never seen those bytes.',
	},
	{
		k: 'A compaction ends it',
		v: 'The licence to replace forty lines with a handle is that the agent is still holding those lines. When the context window compacts, that stops being true, so OMNI deliberately forgets what it had shown. It cannot stop a compaction, only push it further out.',
		quiet: true,
	},
];

const memory = [
	{
		k: 'New session',
		was: 'You re-explain the project layout, which module is broken, and that it is Postgres rather than MySQL.',
		now: 'The agent already has it. You carry on from where you stopped.',
	},
	{
		k: 'Bug you already fixed',
		was: 'The agent walks into the same framework quirk it solved yesterday, because nothing kept the answer.',
		now: 'The agent pulls the stored fix back through omni_recall before it repeats the mistake.',
	},
	{
		k: 'Cursor to Claude Code',
		was: 'New editor, new agent, no context. You start over.',
		now: 'The session summary is injected on the way in. The new agent is current.',
	},
	{
		k: 'Agent drifts off task',
		was: 'Three prompts later it is refactoring something you never asked about.',
		now: 'omni goal restates the objective on every prompt.',
	},
];

/* Straight from the README's "What each host lets OMNI do". The tiers are a
   support claim, so they are copied rather than paraphrased: a host listed one
   tier too high is the site promising shell distillation the host cannot do.
   Check against the README on main before editing, and against `omni doctor`,
   which prints the tier for every installed host. */
const hosts = [
	{
		k: 'Full',
		names: 'Claude Code, Codex CLI, Gemini CLI, Aider (pipe)',
		v: "The host applies OMNI's rewrite, so the model reads distilled output from its own built-in tools.",
	},
	{
		k: 'Handoff-first',
		names: 'Cursor, Windsurf',
		v: 'The host cannot rewrite built-in tool output. <code>omni_run</code> distils anything you route through it, and <code>omni init --cursor</code> installs the rule that makes the agent reach for it.',
	},
	{
		k: 'MCP-only',
		names: 'Cline, Roo, OpenCode, VS Code, Zed, Copilot, Antigravity, Hermes, Pi',
		v: 'Memory, recall and session state. No shell distillation, and no claim of it.',
	},
];

/* A subset of `omni help`, not the whole of it. Every entry exists in BOTH the
 * released binary and main.
 *
 * Do not add a command from docs/ without running `omni <cmd> --help` against an
 * installed build first. Three entries here were wrong: `omni trust` is documented
 * in HOW_TO_USE.md but the binary answers "unknown command", `omni rewind` shipped
 * in v0.6.3 then got deleted on main, and `omni learn` went with the filter layer
 * in 0.7.4, which the manual had already stopped documenting. This list told
 * readers to run it for two releases after the answer became "there are no filters
 * to add".
 */
const commands = [
	{ k: 'omni init', v: 'Wire the hook into Claude Code, Cursor, Windsurf, Codex or Antigravity. Interactive.' },
	{ k: 'omni doctor --fix', v: 'Check the hooks and the MCP wiring, then repair whatever is broken.' },
	{ k: 'omni stats', v: 'What it actually saved on your machine. Takes <code>--today</code>, <code>--week</code>, <code>--month</code>.' },
	{ k: 'omni retrieve', v: 'Print what a marker archived, by the 16 characters inside it. Works on every host, MCP or not.' },
	{ k: 'omni diff', v: 'The last raw input beside what the agent received. This is how you check its work.' },
	{ k: 'omni dashboard', v: 'The same numbers <code>omni stats</code> reads, in a browser. Loopback only, read only.' },
	{ k: 'omni session --status', v: 'Context pressure, stored engrams, and the errors still open in this session.' },
	{ k: 'omni goal', v: 'Set the objective once. OMNI restates it on every prompt so the agent stops drifting.' },
	{ k: 'omni remember', v: 'Store a project rule or a gotcha in local SQLite. Recalled by semantic search later.' },
	{ k: 'omni reset', v: 'Take it back out. Clean uninstall, keeping a backup of your config.' },
];

/* Questions people actually ask before installing something that sits between
   their agent and their terminal. Answers are kept to roughly 40 to 60 words so
   they survive extraction into an AI answer without losing their meaning. */
const faq = [
	{
		q: 'Does OMNI delete my logs?',
		a: 'No. What it cuts is archived to a local SQLite store keyed by SHA-256, and the marker carries the handle that pulls the original back. Inputs over 64 KB are not archived, and the marker on those says so with the size. Nothing leaves your machine.',
	},
	{
		q: 'Will it slow down my terminal?',
		a: `Yes, measurably. OMNI runs on every hooked command and the cost grows with your history. A 496 byte git status takes about 21ms against a fresh database and about 61ms against a 205 MB one. A 16.5 KB cargo test takes about 24ms and 65ms.`,
	},
	{
		q: 'How much does it actually save?',
		/* "where the filters can take nothing without guessing" was true when file
		   reads read 0.0% from the filters. They read 39.2% now, so the clause was
		   deleted rather than reworded. */
		a: `On the output that actually carries noise, ${best.command} is ${best.savings}. On file reads it is ${fileRead?.savings ?? '89.6%'}, most of which is the ledger rather than the filters. Across the whole mix it averages ${stats.overallSaved}, because OMNI leaves ${stats.zeroSaveShare} of ${stats.totalCalls} replayed commands untouched rather than inventing a saving, and adds zero bytes to them. Read the per-class number for the work you actually do, and the average as a floor. That average also depends on what you run: the corpus behind it is a heavy week, and an ordinary one reads 14.9%.`,
	},
	{
		q: 'Can it hide an error from my agent?',
		a: 'No. Any command that exits non-zero passes through verbatim, uncompressed. Structured output such as JSON, YAML, NDJSON and CSV is never touched. A distiller that cannot parse its input returns the raw output rather than summarising it.',
	},
	{
		q: 'Which agents does it work with?',
		a: 'Fifteen hosts across three tiers, listed above under Supported agents, and what you get differs by tier. Only a host that can rewrite its own tool output gets shell distillation; the rest get memory and no claim of more. It installs as a shell hook rather than a wrapper, so nothing about how you work changes.',
	},
	{
		q: 'Can I add filters for my own tools?',
		a: 'There are no filters to add. The pattern-matching layer was retired in 0.7.4 after it measured at 2,018 bytes over 6,656 commands, 0.031% of the corpus, while costing 5 to 7ms of the hook\'s 10ms budget. What remains is the Rust distillers and the ledger, both compiled in, so the set that runs is the set the tests cover. If a tool needs handling, open an issue and it ships in the binary for everyone.',
	},
	{
		q: 'How do I get back something OMNI folded?',
		a: 'omni retrieve <handle>, where the handle is the 16 characters inside the marker. It works on every host, with or without MCP, and agents that have the MCP server wired can call omni_retrieve instead. The archive is a rolling 30 day window, so a handle older than that will not resolve.',
	},
	{
		q: 'What does OMNI cost?',
		a: 'Nothing. It is Apache 2.0 licensed with no paid tier, no account and no telemetry. If it saves you nothing, omni stats will tell you so and omni reset removes it.',
	},
];

// Product plus FAQ. Both describe this page, so both belong in its graph.
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: 'OMNI',
		alternateName: 'OMNI context engine',
		applicationCategory: 'DeveloperApplication',
		applicationSubCategory: 'Command line tool',
		operatingSystem: 'macOS, Linux, Windows',
		description: 'Noise-canceling context and long-term memory for AI coding agents. Cuts terminal noise before the agent reads it, and remembers your project between sessions.',
		url: 'https://omni.weekndlabs.com',
		downloadUrl: 'https://github.com/fajarhide/omni/releases',
		codeRepository: 'https://github.com/fajarhide/omni',
		programmingLanguage: 'Rust',
		license: 'https://github.com/fajarhide/omni/blob/main/LICENSE',
		softwareVersion: latestVersion.replace(/^v/, ''),
		isAccessibleForFree: true,
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
		author: { '@type': 'Person', name: 'Fajar Hidayat', url: 'https://github.com/fajarhide' },
		featureList: [
			'Distills noisy terminal output before it reaches the model',
			'Archives everything it removes to a local SQLite store, retrievable by hash',
			'Passes failing commands and structured data through untouched',
			'Carries project memory across sessions and across editors',
			'Runs as an MCP server and a shell hook',
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faq.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: { '@type': 'Answer', text: f.a },
		})),
	},
];

/* The order is `Read → Guard → Score → Distill → [Collapse] → Ledger → Persist`,
   copied from the manual's pipeline page rather than remembered. This list had
   Collapse before Distill, which is the mistake the manual itself carried for two
   releases, and it had no Ledger stage at all while the benchmark table three
   sections up printed a "With ledger" column. */
const pipeline = [
	{ k: 'Read', v: 'A shell hook catches stdout on its way to the agent. Nothing about how you work changes.' },
	{ k: 'Guard', v: 'Non-zero exit, or JSON, YAML, NDJSON, CSV? Straight through. <strong>This branch is taken more often than not.</strong>', quiet: true },
	{ k: 'Score', v: 'Every line gets a weight. Stack frames and errors score high, progress bars and passing tests score low.' },
	{ k: 'Distill', v: 'A command-specific reader runs on the raw text. Returning the input is always allowed, inventing a summary is not.' },
	{ k: 'Collapse', v: 'A fallback rather than a step, taken only when the distilled form failed to earn its keep. Runs of near-identical lines fold into a count.' },
	{ k: 'Ledger', v: 'What survives is checked against what this session has already been shown. A run of lines the agent is still holding becomes one marker and a handle. <strong>This is where most of the saving now comes from.</strong>' },
	{ k: 'Persist', v: 'Everything cut is hashed into local SQLite before the marker is written, so a handle never names content that was not stored. Inputs over 64 KB are the one exception, and they say so.' },
];
---

<Layout
	title="OMNI, stop paying to re-read the same terminal output"
	{/* Kept under 160 characters so the whole line survives the SERP. Every
	    number is parsed from the manual, so the claim cannot drift. It carried
	    "git 89%, cargo 91%, kubectl 77%" for a while, and none of the three
	    appeared anywhere in the repository. */}
	description={`Free Rust CLI. Output your AI agent has already been shown comes back as a handle, not the bytes again: ${fileRead?.savings ?? '89.6%'} off file reads, ${stats.overallSaved} across ${stats.totalCalls} real commands.`}
	jsonLd={jsonLd}
>
	<main>
		<!-- HERO -->
		<section class="hero">
			<div class="wrap">
				<div class="hero-grid">
					<div>
						{/* One claim, in the words the README leads with. The line here was
						    "Claude is not expensive. Your terminal is.", which is the
						    not-X-but-Y shape, and the lede under it carried five sentences
						    of everything the page says further down. */}
						<h1 class="t-display">Stop paying to <span class="text-brand">re-read</span><br />the same output<span class="text-brand">.</span></h1>

						{/* Both figures are emphasised, not only the big one. Bolding the
						    best case and leaving the aggregate in body weight is the move
						    the band below calls out, and it would be this page doing it. */}
						<p class="lede">
							OMNI is a shell hook for your coding agent. It drops the noise from command output before the model reads it, and returns what the model has already been shown as a handle rather than the bytes again: <strong>{best.savings}</strong> off {best.command} output, <strong>{stats.overallSaved}</strong> across all {stats.totalCalls} replayed commands.
						</p>

						<div class="hero-actions">
							<a href={GITHUB_REPO} class="btn btn-solid" target="_blank" rel="noopener noreferrer">
								<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
