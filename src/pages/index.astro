					<span class="badge-version" id="omni-version" data-initial-version={latestVersion}>{latestVersion}</span>
					<span class="badge-divider"></span>
					<span class="badge-label" id="omni-status" data-status={versionLabel.toLowerCase().replace(' ', '-')}>{versionLabel}</span>
				</div>
				
