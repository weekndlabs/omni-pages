    <script>
        // Hero canvas animation (from script.js)
        const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
        if (canvas) {
            const ctx = canvas.getContext('2d');
            let particles: Array<{x: number, y: number, radius: number, vx: number, vy: number, alpha: number}> = [];
            
            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            for (let i = 0; i < 50; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    radius: Math.random() * 2,
                    vx: (Math.random() - 0.5) * 0.5,
                    vy: (Math.random() - 0.5) * 0.5,
                    alpha: Math.random() * 0.5
                });
            }

            function draw() {
                if (!ctx) return;
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                ctx.fillStyle = '#a1a1aa';
                particles.forEach(p => {
                    p.x += p.vx;
                    p.y += p.vy;
                    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                    
                    ctx.globalAlpha = p.alpha;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                    ctx.fill();
                });
                requestAnimationFrame(draw);
            }
            draw();
        }

        // Copy button logic
        document.querySelectorAll('.copy-btn, .text-link').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const target = e.currentTarget as HTMLElement;
                const text = target.getAttribute('data-copy');
                if (text) {
                    navigator.clipboard.writeText(text);
                    const original = target.innerHTML;
                    if (target.classList.contains('copy-btn')) {
                        target.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent-green)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>';
                        setTimeout(() => target.innerHTML = original, 2000);
                    } else {
                        target.style.color = 'var(--accent-green)';
                        target.innerText = 'Copied!';
                        setTimeout(() => {
                            target.style.color = '';
                            target.innerText = original;
                        }, 2000);
                    }
                }
            });
        });

        // Dynamic Version Sync (Client-side)
        async function syncVersion() {
            const getLabel = (v) => {
                if (v.includes('-rc')) return 'Release Candidate';
                if (v.includes('-alpha')) return 'Alpha Release';
                if (v.includes('-beta')) return 'Beta Release';
                return 'Stable';
            };
            
            try {
                const res = await fetch('https://api.github.com/repos/fajarhide/omni/releases/latest');
                if (res.ok) {
                    const data = await res.json();
                    const versionEl = document.getElementById('omni-version');
                    const statusEl = document.getElementById('omni-status');
                    
                    if (versionEl && data.tag_name !== versionEl.innerText) {
                        versionEl.innerText = data.tag_name;
                        if (statusEl) {
                            const newLabel = getLabel(data.tag_name);
                            statusEl.innerText = newLabel;
                            statusEl.setAttribute('data-status', newLabel.toLowerCase().replace(' ', '-'));
                        }
                    }
                }
            } catch (e) {}
        }
        syncVersion();
    </script>
</Layout>
