	<script define:vars={{ reels: demos.map((d) => ({ ...d.fixture, label: d.label, context: d.context, cap: d.cap, noise: d.lines.filter((l) => l.n).length })) }}>
		// The signature: the subtraction runs on a slow loop while the block is on
		// screen, so a reader who arrives mid-cycle still sees it happen. Three
		// commands take turns, because one 93% demo would misrepresent the tool.
		const demo = document.getElementById('demo');
		const el = (id) => document.getElementById(id);
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		function setPhase(label, on) {
			const phase = el('phase');
			phase.textContent = label;
			if (on) phase.setAttribute('data-on', '');
			else phase.removeAttribute('data-on');
		}

		function show(i) {
			demo.querySelectorAll('.reel').forEach((r) => {
				r.hidden = Number(r.dataset.reel) !== i;
			});
			el('reel-label').textContent = reels[i].label;
			el('reel-ctx').textContent = reels[i].context;
			el('reel-saved').textContent = reels[i].savings + ' smaller';
			el('reel-cap').textContent = reels[i].cap;
			el('meter').textContent = reels[i].input;
		}

		if (demo && reduced) {
			// No loop and no cycling. One command, shown already distilled.
			demo.classList.add('scoring', 'cut');
			setPhase('distilled', true);
			el('meter').textContent = reels[0].output;
		} else if (demo) {
			let onScreen = false;
			new IntersectionObserver(
				(entries) => entries.forEach((e) => { onScreen = e.isIntersecting; }),
				{ threshold: 0.25 }
			).observe(demo);

			const wait = (ms) => new Promise((r) => setTimeout(r, ms));

			(async () => {
				for (let i = 0; ; i = (i + 1) % reels.length) {
					while (!onScreen) await wait(400);
					show(i);
					setPhase('raw', false);
					await wait(1600);                        // the output as the shell wrote it
					demo.classList.add('scoring');
					setPhase('scoring', true);
					await wait(reels[i].noise * 110 + 400);  // the strike walks every noise line
					demo.classList.add('cut');
					setPhase('distilled', true);
					el('meter').textContent = reels[i].output;
					await wait(4200);                        // hold on what survived
					demo.classList.remove('scoring', 'cut');
					await wait(700);                         // let the lines come back up
				}
			})();
		}

		// Copy buttons.
		document.querySelectorAll('[data-copy]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const text = btn.getAttribute('data-copy');
				if (!text) return;
				navigator.clipboard.writeText(text);
				const original = btn.innerHTML;
				btn.innerHTML = btn.classList.contains('copy')
					? '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>'
					: 'Copied';
				setTimeout(() => { btn.innerHTML = original; }, 1800);
			});
		});

		// Keep the release badge current between deploys.
		fetch('https://api.github.com/repos/fajarhide/omni/releases/latest')
			.then((r) => (r.ok ? r.json() : null))
			.then((data) => {
				if (!data) return;
				const v = document.getElementById('omni-version');
				const s = document.getElementById('omni-status');
				if (v && data.tag_name !== v.textContent) {
					v.textContent = data.tag_name;
					const tag = data.tag_name;
					const label = tag.includes('-rc') ? 'Release candidate'
						: tag.includes('-alpha') ? 'Alpha'
						: tag.includes('-beta') ? 'Beta'
						: 'Stable';
					if (s) {
						s.textContent = label;
						s.setAttribute('data-status', label.toLowerCase().replace(' ', '-'));
					}
				}
			})
			.catch(() => {});
	</script>
</Layout>
