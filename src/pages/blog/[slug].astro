---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { RC_SLUG, wordsIn, relatedFor } from '../../lib/blog.js';
import { glanceFor, newestFirst } from '../../lib/cover.js';
import Cover from '../../components/Cover.astro';

export async function getStaticPaths() {
  const all = await getCollection('blog');
  return all.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, all },
  }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);

const wordCount = wordsIn(entry);
const readTime = Math.ceil(wordCount / 200) || 1;

const dateStr = entry.data.date.toLocaleDateString('en-US', {
	month: 'long', day: 'numeric', year: 'numeric'
});
const iso = entry.data.date.toISOString();
const author = entry.data.author || 'Fajar Hidayat';
const url = new URL(`/blog/${entry.id}`, Astro.site || 'https://omni.weekndlabs.com').toString();

const isReleaseCandidate = RC_SLUG.test(entry.id);

/* Most post titles already say OMNI, so appending the brand pushed 18 of 50
   titles past the ~60 characters a SERP shows and got them truncated. Only
   append when the title does not name the product itself. */
const pageTitle = /\b(OMNI|Contexere)\b/i.test(entry.data.title)
	? entry.data.title
	: `${entry.data.title}, Contexere`;

/* The post in five seconds: its description, then its first list if the post
   opens with one. Backticks become code; the body below is untouched. */
const glance = glanceFor(entry.body || '', entry.data.description);
const glanceRows = [glance.description, ...glance.bullets].map((t) => t.split('`'));

/* There were zero links between any of the 42 posts, so nothing pointed at the
   handful worth reading and no topical cluster could form. Every post now links
   to three evergreen posts, rotated so the links spread rather than piling onto
   the same three pages. */
const related = relatedFor(entry, all);

/* Date-adjacent neighbours, so a crawler can walk the archive without bouncing
   back to the index between every post. */
const ordered = [...all].sort((a, b) => newestFirst(b, a));
const i = ordered.findIndex((p) => p.id === entry.id);
const prev = ordered[i - 1];
const next = ordered[i + 1];

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: entry.data.title,
	description: entry.data.description,
	datePublished: iso,
	dateModified: iso,
	wordCount,
	inLanguage: 'en',
	mainEntityOfPage: { '@type': 'WebPage', '@id': url },
	author: { '@type': 'Person', name: author, url: 'https://github.com/fajarhide' },
	publisher: { '@type': 'Organization', name: 'Contexere', url: 'https://omni.weekndlabs.com' },
	isPartOf: { '@type': 'Blog', name: 'Contexere Journal', url: 'https://omni.weekndlabs.com/blog' },
	about: { '@type': 'SoftwareApplication', name: 'Contexere', applicationCategory: 'DeveloperApplication' },
};

/* Posts sit two levels down and nothing told a crawler that, so every result
   printed the bare URL. With this, the SERP shows the trail instead. */
const breadcrumbs = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Contexere', item: 'https://omni.weekndlabs.com' },
		{ '@type': 'ListItem', position: 2, name: 'Journal', item: 'https://omni.weekndlabs.com/blog' },
		{ '@type': 'ListItem', position: 3, name: entry.data.title, item: url },
	],
};
---

<Layout
	title={pageTitle}
	description={entry.data.description}
	image={entry.data.image}
	imageAlt={entry.data.imageAlt}
	author={author}
	publishDate={iso}
	jsonLd={[jsonLd, breadcrumbs]}
	noindex={isReleaseCandidate}
>
	<article class="wrap article">
		<header class="article-head">
			{entry.data.tag && <span class="post-tag">{entry.data.tag}</span>}
			<h1>{entry.data.title}</h1>
			<div class="article-meta">
				<span>{author}</span>
				<time datetime={iso}>{dateStr}</time>
				<span>{readTime} min read</span>
			</div>
		</header>

		<Cover size="wide" title={entry.data.title} image={entry.data.image} imageAlt={entry.data.imageAlt} />

		<section class="glance" aria-label="What you get">
			<h2 class="glance-h">What you get</h2>
			<ul>
				{glanceRows.map((parts) => (
					<li>{parts.map((t, k) => (k % 2 ? <code>{t}</code> : t))}</li>
				))}
			</ul>
		</section>

		{isReleaseCandidate && (
			<p class="rc-note">
				This is a release candidate note, kept as project history. For what shipped, see the <a href="/blog">journal index</a> or the <a href="https://github.com/fajarhide/omni/releases" target="_blank" rel="noopener noreferrer">releases</a>.
			</p>
		)}

		<div class="prose">
			<Content />
		</div>

		<nav class="article-foot" aria-label="More from the journal">
			{related.length > 0 && (
				<div class="more">
					<h2 class="more-h">Worth reading next</h2>
					<dl class="rows">
						{related.map((p) => (
							<div class="row">
								<dt class="row-k"><a href={`/blog/${p.id}`}>{p.data.title}</a></dt>
								<dd class="row-v">{p.data.description}</dd>
							</div>
						))}
					</dl>
				</div>
			)}

			<div class="stepper">
				{prev ? <a href={`/blog/${prev.id}`} class="step-prev">Earlier: {prev.data.title}</a> : <span />}
				{next && <a href={`/blog/${next.id}`} class="step-next">Later: {next.data.title}</a>}
			</div>

			<a href="/blog" class="btn btn-ghost btn-sm">All posts</a>
		</nav>
	</article>
</Layout>
