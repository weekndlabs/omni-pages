---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { RC_SLUG, wordsIn } from '../../lib/blog.js';
import { eraOf } from '../../lib/cover.js';
import Cover from '../../components/Cover.astro';

const all = await getCollection('blog');
/* Same-day releases (0.8.0 and 0.8.1 both shipped on Oct 29) fall back to the
   id, which carries the version, so the later release still lists first. */
const sorted = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || b.id.localeCompare(a.id));

/* Fourteen of the forty-two posts are release-candidate notes. Listed inline
   they buried everything else, so they get their own compact group at the end.
   They are noindexed too, see astro.config.mjs. */
const posts = sorted.filter((p) => !RC_SLUG.test(p.id));
const candidates = sorted.filter((p) => RC_SLUG.test(p.id));

const lead = posts.find((p) => p.data.featured);
const rest = posts.filter((p) => p !== lead);

/* One thread per era, newest first: the posts since the rename, then the OMNI
   history under its own name. */
const eras = [
	{ name: 'Contexere', posts: rest.filter((p) => eraOf(p.data.date) === 'contexere') },
	{ name: 'OMNI', posts: rest.filter((p) => eraOf(p.data.date) === 'omni') },
].filter((e) => e.posts.length);

const fmt = (d) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const iso = (d) => d.toISOString();

/* Without this the index inherited the site-wide SoftwareApplication schema, so
   the one page that is unambiguously a blog did not say it was one. Release
   candidates are left out to match what the sitemap and the index already do. */
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Blog',
	name: 'Contexere Journal',
	url: 'https://omni.weekndlabs.com/blog',
	inLanguage: 'en',
	publisher: { '@type': 'Organization', name: 'Contexere', url: 'https://omni.weekndlabs.com' },
	blogPost: posts.map((p) => ({
		'@type': 'BlogPosting',
		headline: p.data.title,
		description: p.data.description,
		datePublished: iso(p.data.date),
		url: `https://omni.weekndlabs.com/blog/${p.id}`,
		author: { '@type': 'Person', name: p.data.author || 'Fajar Hidayat' },
	})),
};
---

<Layout
	title="Contexere journal, release notes and benchmark write-ups"
	description="Release notes, architecture write-ups, and the benchmark work behind Contexere, formerly OMNI, the context layer for AI coding agents."
	jsonLd={jsonLd}
>
	<div class="wrap wrap-doc">
		<header class="page-head">
			<span class="eyebrow">Journal</span>
			<h1 class="t-section">What changed, and why</h1>
			<p class="lede">Release notes, architecture write-ups, and the benchmark work behind the numbers on the front page.</p>
		</header>

		<div class="posts">
			{lead && (
				<a href={`/blog/${lead.id}`} class="post-row is-lead">
					<time class="post-when" datetime={iso(lead.data.date)}>{fmt(lead.data.date)}</time>
					<div>
						{/* The lead is pinned above a list sorted newest first, so its older
						    date reads as a sorting bug unless the row says why it is there. */}
						<span class="post-tag">Start here{lead.data.tag && ` · ${lead.data.tag}`}</span>
						<h2><span class="post-title">{lead.data.title}</span></h2>
						<p class="post-excerpt">{lead.data.description}</p>
					</div>
				</a>
			)}

			{eras.map((era) => (
				<section class="era">
					<h2 class="era-h">{era.name}</h2>
					<ol class="thread">
						{era.posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}`} class="thread-row">
									<Cover size="row" title={post.data.title} image={post.data.image} imageAlt={post.data.imageAlt} />
									<div>
										<time class="post-when" datetime={iso(post.data.date)}>{fmt(post.data.date)}</time>
										<h3 class="post-title">{post.data.title}</h3>
										<p class="post-excerpt">{post.data.description}</p>
									</div>
								</a>
							</li>
						))}
					</ol>
				</section>
			))}
		</div>

		{candidates.length > 0 && (
			<section class="rc-archive">
				<h2 class="rc-h">Release candidates</h2>
				<p class="fine">
					Pre-release notes, kept as history. Not indexed, because nothing here is what finally shipped.
				</p>
				<ul class="rc-list">
					{candidates.map((p) => (
						<li>
							<a href={`/blog/${p.id}`}>{p.data.title}</a>
							<time datetime={iso(p.data.date)}>{fmt(p.data.date)}</time>
						</li>
					))}
				</ul>
			</section>
		)}
	</div>
</Layout>
