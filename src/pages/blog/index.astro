---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { RC_SLUG, wordsIn } from '../../lib/blog.js';

const all = await getCollection('blog');
const sorted = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

/* Fourteen of the forty-two posts are release-candidate notes. Listed inline
   they buried everything else, so they get their own compact group at the end.
   They are noindexed too, see astro.config.mjs. */
const posts = sorted.filter((p) => !RC_SLUG.test(p.id));
const candidates = sorted.filter((p) => RC_SLUG.test(p.id));

const lead = posts.find((p) => p.data.featured);
const rest = posts.filter((p) => p !== lead);

const fmt = (d) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const iso = (d) => d.toISOString();
---

<Layout
	title="OMNI journal, release notes and benchmark write-ups"
	description="Release notes, architecture write-ups, and the benchmark work behind OMNI, the Rust CLI that cuts terminal noise before your AI coding agent reads it."
>
	<div class="wrap">
		<header class="page-head">
			<span class="eyebrow">Journal</span>
			<h1 class="t-section">What changed, and why</h1>
			<p class="lede">Release notes, architecture write-ups, and the benchmark work behind the numbers on the front page.</p>
		</header>

		<div class="posts">
			{lead && (
				<a href={`/blog/${lead.id}`} class="post-row is-lead">
					<time class="post-when" datetime={iso(lead.data.date)}>{fmt(lead.data.date)}</time>
					<div>
						{lead.data.tag && <span class="post-tag">{lead.data.tag}</span>}
						<h2><span class="post-title">{lead.data.title}</span></h2>
						<p class="post-excerpt">{lead.data.description}</p>
					</div>
				</a>
			)}

			{rest.map((post) => (
				<a href={`/blog/${post.id}`} class="post-row">
					<time class="post-when" datetime={iso(post.data.date)}>{fmt(post.data.date)}</time>
					<div>
						{post.data.tag && <span class="post-tag">{post.data.tag}</span>}
						<h2><span class="post-title">{post.data.title}</span></h2>
						<p class="post-excerpt">{post.data.description}</p>
					</div>
				</a>
			))}
		</div>

		{candidates.length > 0 && (
			<section class="rc-archive">
				<h2 class="rc-h">Release candidates</h2>
				<p class="fine">
					Pre-release notes, kept as history. Not indexed, because nothing here is what finally shipped.
				</p>
				<ul class="rc-list">
					{candidates.map((p) => (
						<li>
							<a href={`/blog/${p.id}`}>{p.data.title}</a>
							<time datetime={iso(p.data.date)}>{fmt(p.data.date)}</time>
						</li>
					))}
				</ul>
			</section>
		)}
	</div>
</Layout>
